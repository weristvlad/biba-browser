+std::optional<SkColor> SiteToolbarColor(const views::View* view,
+                                        const BrowserView* browser_view) {
+  if (!browser_view || !browser_view->GetIsNormalType() ||
+      !view->GetColorProvider()) {
+    return std::nullopt;
+  }
+  content::WebContents* contents =
+      const_cast<BrowserView*>(browser_view)->GetActiveWebContents();
+  if (!contents) {
+    return std::nullopt;
+  }
+  std::optional<SkColor> site = contents->GetThemeColor();
+  if (!site) {
+    site = contents->GetBackgroundColor();
+  }
+  if (!site || SkColorGetA(*site) != SK_AlphaOPAQUE) {
+    return std::nullopt;
+  }
+  // Toolbar text and icons follow the browser theme, so only take colours on
+  // the theme's side (dark page in dark mode, light page in light mode).
+  const SkColor toolbar = view->GetColorProvider()->GetColor(kColorToolbar);
+  if (color_utils::IsDark(*site) != color_utils::IsDark(toolbar)) {
+    return std::nullopt;
+  }
+  return site;
+}
