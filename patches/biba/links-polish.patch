+// Biba: a soft dark rounded square behind a small button while it is hovered
+// or pressed, so it's clear what the pointer is on (close, copy link, unpin).
+class BibaHoverBackground : public views::Background {
+ public:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    const auto* button = views::AsViewClass<views::Button>(view);
+    if (!button || (button->GetState() != views::Button::STATE_HOVERED &&
+                    button->GetState() != views::Button::STATE_PRESSED)) {
+      return;
+    }
+    const ui::ColorProvider* colors = view->GetColorProvider();
+    const bool dark =
+        colors && color_utils::IsDark(colors->GetColor(ui::kColorSysSurface));
+    const bool pressed = button->GetState() == views::Button::STATE_PRESSED;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(dark ? SK_ColorWHITE : SK_ColorBLACK,
+                               pressed ? 0x2E : 0x1A));
+    gfx::RectF rect(view->GetLocalBounds());
+    // A square centred in the button, at most 22pt.
+    const float side = std::min({rect.width(), rect.height(), 22.0f});
+    rect.ClampToCenteredSize(gfx::SizeF(side, side));
+    canvas->DrawRoundRect(rect, 6, flags);
+  }
+};
+
+inline void BibaSetHoverBackground(views::View* button) {
+  button->SetBackground(std::make_unique<BibaHoverBackground>());
+}
