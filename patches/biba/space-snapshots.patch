+int BibaSpaceSwipeHandler::SnapshotClipHeight() const {
+  int clip = sidebar_->height();
+  for (const views::View* child : sidebar_->children()) {
+    if (std::string_view(child->GetClassName()) == "BibaSpaceSwitcherView") {
+      clip = child->y();
+    }
+  }
+  return clip;
+}
+
+void BibaSpaceSwipeHandler::CaptureSnapshot() {
+  ui::Layer* layer = sidebar_ ? sidebar_->layer() : nullptr;
+  // Only a list at rest is a faithful picture of the Space.
+  if (!layer || tracking_ || offset_ != 0.0f ||
+      (preview_ && preview_->GetVisible()) || sidebar_->bounds().IsEmpty()) {
+    return;
+  }
+  const auto* commands = chrome::BrowserCommandController::From(browser_);
+  const int space = commands ? commands->biba_active_space() : 0;
+  const float scale = layer->device_scale_factor();
+  auto request = std::make_unique<viz::CopyOutputRequest>(
+      viz::CopyOutputRequest::ResultFormat::RGBA,
+      viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+      base::BindOnce(
+          [](base::WeakPtr<BibaSpaceSwipeHandler> self, int space, float scale,
+             std::unique_ptr<viz::CopyOutputResult> result) {
+            if (!self || result->IsEmpty()) {
+              return;
+            }
+            auto scoped = result->ScopedAccessSkBitmap();
+            SkBitmap bitmap = scoped.GetOutScopedBitmap();
+            if (bitmap.drawsNothing()) {
+              return;
+            }
+            self->snapshots_[space] =
+                gfx::ImageSkia(gfx::ImageSkiaRep(bitmap, scale));
+          },
+          weak_factory_.GetWeakPtr(), space, scale));
+  layer->RequestCopyOfOutput(std::move(request));
+}
 
