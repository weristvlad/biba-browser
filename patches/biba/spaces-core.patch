+// Copyright 2026 The Biba Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_BIBA_BIBA_SPACES_CONTROLLER_H_
+#define CHROME_BROWSER_UI_BIBA_BIBA_SPACES_CONTROLLER_H_
+
+#include <array>
+#include <memory>
+#include <variant>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+
+class TabStripModel;
+struct DetachedTab;
+struct DetachedTabCollection;
+
+namespace tabs {
+class TabInterface;
+}
+
+// Owns the Spaces of one browser window.
+//
+// A Space is the set of unpinned tabs (including their groups and splits)
+// shown in the window. Pinned tabs are shared by all Spaces. The active
+// Space's tabs live in the window's TabStripModel; every other Space's tabs
+// are kept here, detached from the strip but alive, using the same
+// detach/insert machinery Chromium uses to move tabs between windows.
+class BibaSpacesController {
+ public:
+  static constexpr int kMaxSpaces = 9;
+
+  explicit BibaSpacesController(TabStripModel* tab_strip_model);
+  BibaSpacesController(const BibaSpacesController&) = delete;
+  BibaSpacesController& operator=(const BibaSpacesController&) = delete;
+  ~BibaSpacesController();
+
+  int active_space() const { return active_space_; }
+
+  // Makes Space `index` (0-based) the visible one. A Space that has never
+  // been opened starts with a single new tab.
+  void SwitchToSpace(int index);
+
+ private:
+  using DetachedItem = std::variant<std::unique_ptr<DetachedTab>,
+                                    std::unique_ptr<DetachedTabCollection>>;
+
+  struct Space {
+    Space();
+    Space(Space&&);
+    Space& operator=(Space&&);
+    ~Space();
+
+    // Tabs, groups and splits in strip order while the Space is inactive.
+    std::vector<DetachedItem> items;
+    // Tab to re-activate when the Space becomes visible again.
+    raw_ptr<tabs::TabInterface> last_active_tab = nullptr;
+  };
+
+  // Inserts `space`'s detached items at the end of the strip and returns the
+  // tab that should become active, if any.
+  tabs::TabInterface* AttachSpace(Space& space);
+
+  raw_ptr<TabStripModel> tab_strip_model_;
+  std::array<Space, kMaxSpaces> spaces_;
+  int active_space_ = 0;
+};
+
+#endif  // CHROME_BROWSER_UI_BIBA_BIBA_SPACES_CONTROLLER_H_
