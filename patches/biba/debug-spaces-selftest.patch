+// --- DEBUG: self test -------------------------------------------------------
+
+void BibaSpacesController::RunSelfTest(BrowserWindowInterface* browser,
+                                       const base::FilePath& shots_dir) {
+  debug_browser_ = browser;
+  shots_dir_ = shots_dir;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&BibaSpacesController::SelfTestStep,
+                     weak_factory_.GetWeakPtr(), 0),
+      base::Seconds(8));
+}
+
+void BibaSpacesController::SelfTestStep(int step) {
+  // 0: initial, 1: -> Space 2 (fresh), 2: -> Space 1, 3: -> Space 2 again,
+  // 4: -> Space 1 again.
+  static constexpr int kTarget[] = {-1, 1, 0, 1, 0};
+  if (step > 0) {
+    SwitchToSpace(kTarget[step]);
+  }
+  std::string label = "step " + base::NumberToString(step) + " space " +
+                      base::NumberToString(active_space_ + 1);
+  LogStrip(label.c_str());
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&BibaSpacesController::SaveWindowShot,
+                     weak_factory_.GetWeakPtr(),
+                     "step" + base::NumberToString(step) + "-space" +
+                         base::NumberToString(active_space_ + 1)),
+      base::Milliseconds(1500));
+  if (step + 1 < static_cast<int>(std::size(kTarget))) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&BibaSpacesController::SelfTestStep,
+                       weak_factory_.GetWeakPtr(), step + 1),
+        base::Seconds(3));
+  } else {
+    LOG(ERROR) << "[biba-selftest] done";
+  }
+}
+
+void BibaSpacesController::LogStrip(const char* label) {
+  TabStripModel* model = tab_strip_model_.get();
+  std::string tabs;
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    tabs += base::UTF16ToUTF8(contents->GetTitle()) + " <" +
+            contents->GetVisibleURL().spec() + ">";
+    if (i == model->active_index()) {
+      tabs += "*";
+    }
+    tabs += " | ";
+  }
+  LOG(ERROR) << "[biba-selftest] " << label << " count=" << model->count()
+             << " pinned=" << model->IndexOfFirstNonPinnedTab()
+             << " tabs: " << tabs;
+}
+
+void BibaSpacesController::SaveWindowShot(const std::string& name) {
+  if (shots_dir_.empty() || !debug_browser_ || !debug_browser_->GetWindow()) {
+    return;
+  }
+  ui::BaseWindow* window = debug_browser_->GetWindow();
+  const gfx::Rect bounds(window->GetBounds().size());
+  const base::FilePath path = shots_dir_.AppendASCII(name + ".png");
+  ui::GrabWindowSnapshotAsPNG(
+      window->GetNativeWindow(), bounds,
+      base::BindOnce(
+          [](base::FilePath path, scoped_refptr<base::RefCountedMemory> png) {
+            if (!png) {
+              LOG(ERROR) << "[biba-selftest] snapshot failed: " << path;
+              return;
+            }
+            base::ThreadPool::PostTask(
+                FROM_HERE, {base::MayBlock()},
+                base::BindOnce(
+                    [](base::FilePath path,
+                       scoped_refptr<base::RefCountedMemory> png) {
+                      base::CreateDirectory(path.DirName());
+                      base::WriteFile(path, *png);
+                      LOG(ERROR) << "[biba-selftest] saved " << path;
+                    },
+                    path, png));
+          },
+          path));
+}
