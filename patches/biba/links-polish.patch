+int BibaPinnedLinksView::VisibleRowCount() const {
+  int rows = static_cast<int>(links_.size());
+  if (dragging_index_ >= 0) {
+    --rows;
+  }
+  if (gap_index_ >= 0) {
+    ++rows;
+  }
+  return std::max(0, rows);
+}
+
+void BibaPinnedLinksView::SetDropHover(std::optional<int> y_in_screen) {
+  int gap = -1;
+  if (y_in_screen) {
+    const gfx::Rect bounds = GetBoundsInScreen();
+    // A little reach above and below, so the gap opens as the tab arrives.
+    if (*y_in_screen >= bounds.y() - RowHeight() / 2 &&
+        *y_in_screen < bounds.bottom() + RowHeight() / 2) {
+      const int slots = static_cast<int>(links_.size()) -
+                        (dragging_index_ >= 0 ? 1 : 0);
+      gap = std::clamp((*y_in_screen - bounds.y()) / RowHeight(), 0, slots);
+    }
+  }
+  if (gap == gap_index_) {
+    return;
+  }
+  gap_index_ = gap;
+  AnimateLayout();
+}
+
+void BibaPinnedLinksView::DropTab(content::WebContents* contents) {
+  const int at = gap_index_;
+  gap_index_ = -1;
+  if (!contents) {
+    AnimateLayout();
+    return;
+  }
+  const GURL url = contents->GetLastCommittedURL();
+  if (!url.is_valid()) {
+    AnimateLayout();
+    return;
+  }
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              biba::prefs::kPinnedLinks);
+  base::ListValue* list = update->EnsureList(SpaceKey(ActiveSpace()));
+  for (const base::Value& item : *list) {
+    const std::string* existing =
+        item.is_dict() ? item.GetDict().FindString("url") : nullptr;
+    if (existing && SameLink(GURL(*existing), url)) {
+      return;
+    }
+  }
+  base::DictValue link;
+  link.Set("url", url.spec());
+  link.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  const size_t pos =
+      at < 0 ? list->size()
+             : std::min(static_cast<size_t>(at), list->size());
+  list->Insert(list->begin() + pos, base::Value(std::move(link)));
+  if (tabs::TabInterface* tab = tabs::TabInterface::GetFromContents(contents)) {
+    opened_[url.spec()] = tab->GetHandle();
+  }
+}
+
+void BibaPinnedLinksView::AnimateLayout() {
+  // FLIP: remember where rows are, lay out, then slide them from there.
+  std::vector<int> before;
+  for (views::View* row : children()) {
+    before.push_back(row->y());
+  }
+  PreferredSizeChanged();
+  DeprecatedLayoutImmediately();
+  for (size_t i = 0; i < children().size() && i < before.size(); ++i) {
+    views::View* row = children()[i];
+    const int delta = before[i] - row->y();
+    if (delta == 0 || static_cast<int>(i) == dragging_index_) {
+      continue;
+    }
+    gfx::Transform from;
+    from.Translate(0, delta);
+    row->layer()->GetAnimator()->StopAnimating();
+    row->layer()->SetTransform(from);
+    views::AnimationBuilder()
+        .SetPreemptionStrategy(
+            ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET)
+        .Once()
+        .SetDuration(base::Milliseconds(200))
+        .SetTransform(row->layer(), gfx::Transform(),
+                      gfx::Tween::ACCEL_20_DECEL_100);
+  }
+  SchedulePaint();
+}
