+void BibaSpaceSwipeHandler::FinishPendingSwipe() {
+  if (committing_to_ >= 0) {
+    // Jump the motion to its end; SwitchAfterSwipe() runs from OnEnded (or
+    // directly, if the animations had already been dropped).
+    for (views::View* view : MovableViews()) {
+      if (view->layer()) {
+        view->layer()->GetAnimator()->StopAnimating();
+      }
+    }
+    if (preview_ && preview_->layer()) {
+      preview_->layer()->GetAnimator()->StopAnimating();
+    }
+    SwitchAfterSwipe();
+  }
+  if (reveal_timer_.IsRunning()) {
+    reveal_timer_.Stop();
+    SetOffset(0.0f, 1.0f);
+    HidePreview();
+  }
+}
