+#include "ui/views/widget/widget.h"
+
+namespace biba {
+
+namespace {
+
+// One accent per Space slot (Ctrl+1..9). Saturated mid-tones; how much of the
+// accent reaches the frame is decided by kTint* below.
+constexpr std::array<SkColor, 9> kSpaceAccents = {
+    SkColorSetRGB(0x8B, 0x5C, 0xF6),  // violet
+    SkColorSetRGB(0x3B, 0x82, 0xF6),  // blue
+    SkColorSetRGB(0x10, 0xB9, 0x81),  // green
+    SkColorSetRGB(0xF5, 0x9E, 0x0B),  // amber
+    SkColorSetRGB(0xEC, 0x48, 0x99),  // pink
+    SkColorSetRGB(0xEF, 0x44, 0x44),  // red
+    SkColorSetRGB(0x06, 0xB6, 0xD4),  // cyan
+    SkColorSetRGB(0x84, 0xCC, 0x16),  // lime
+    SkColorSetRGB(0x9C, 0xA3, 0xAF),  // neutral
+};
+
+// Base surfaces the accent is blended into.
+constexpr SkColor kDarkBase = SkColorSetRGB(0x16, 0x16, 0x1A);
+constexpr SkColor kLightBase = SkColorSetRGB(0xF4, 0xF3, 0xF1);
+
+// Accent share at the gradient's two ends (top-left, bottom-right).
+constexpr float kTintStartDark = 0.42f;
+constexpr float kTintEndDark = 0.20f;
+constexpr float kTintStartLight = 0.40f;
+constexpr float kTintEndLight = 0.20f;
+
+// Rotates `color`'s hue by `degrees` (analogous companion for the gradient).
+SkColor RotateHue(SkColor color, double degrees) {
+  color_utils::HSL hsl;
+  color_utils::SkColorToHSL(color, &hsl);
+  hsl.h += degrees / 360.0;
+  if (hsl.h >= 1.0) {
+    hsl.h -= 1.0;
+  }
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+}
+
+// 128x128 tile of monochrome noise, generated once. Alpha is tiny so the grain
+// reads as texture, not as dirt.
+const cc::PaintImage& GrainTile() {
+  static const base::NoDestructor<cc::PaintImage> tile([] {
+    constexpr int kSize = 128;
+    SkBitmap bitmap;
+    bitmap.allocN32Pixels(kSize, kSize);
+    // xorshift32: deterministic, so the grain looks the same every launch.
+    uint32_t state = 0x9E3779B9u;
+    auto next = [&state] {
+      state ^= state << 13;
+      state ^= state >> 17;
+      state ^= state << 5;
+      return state;
+    };
+    for (int y = 0; y < kSize; ++y) {
+      for (int x = 0; x < kSize; ++x) {
+        const uint32_t r = next();
+        const bool light = (r & 1u) != 0;
+        const U8CPU alpha = static_cast<U8CPU>((r >> 1) % 11);
+        *bitmap.getAddr32(x, y) =
+            light ? SkPreMultiplyARGB(alpha, 255, 255, 255)
+                  : SkPreMultiplyARGB(alpha, 0, 0, 0);
+      }
+    }
+    bitmap.setImmutable();
+    return cc::PaintImage::CreateFromBitmap(std::move(bitmap));
+  }());
+  return *tile;
+}
+
+}  // namespace
+
+bool PaintSpaceFrame(gfx::Canvas* canvas,
+                     const views::View* view,
+                     const BrowserView* browser_view) {
+  if (!browser_view || !browser_view->GetIsNormalType() ||
+      !view->GetWidget()) {
+    return false;
+  }
+
+  int space = 0;
+  if (const auto* commands = chrome::BrowserCommandController::From(
+          const_cast<BrowserView*>(browser_view)->browser())) {
+    space = commands->biba_active_space();
+  }
+  const SkColor accent = kSpaceAccents[space % kSpaceAccents.size()];
+
+  const bool dark = color_utils::IsDark(
+      view->GetColorProvider()->GetColor(ui::kColorSysSurface));
+  const SkColor base = dark ? kDarkBase : kLightBase;
+  const SkColor start = color_utils::AlphaBlend(
+      accent, base, dark ? kTintStartDark : kTintStartLight);
+  const SkColor end = color_utils::AlphaBlend(
+      RotateHue(accent, 28), base, dark ? kTintEndDark : kTintEndLight);
+
+  // Lay the gradient out across the whole widget, then shift into `view`'s
+  // coordinates, so sibling frame views continue the same gradient.
+  const gfx::Rect widget_bounds =
+      view->GetWidget()->GetRootView()->GetLocalBounds();
+  gfx::Point origin;
+  views::View::ConvertPointToWidget(view, &origin);
+  const SkPoint points[2] = {
+      SkPoint::Make(-origin.x(), -origin.y()),
+      SkPoint::Make(widget_bounds.width() - origin.x(),
+                    widget_bounds.height() - origin.y())};
+  const SkColor4f colors[2] = {SkColor4f::FromColor(start),
+                               SkColor4f::FromColor(end)};
+
+  cc::PaintFlags flags;
+  flags.setShader(cc::PaintShader::MakeLinearGradient(
+      points, colors, nullptr, 2, SkTileMode::kClamp));
+  canvas->DrawRect(gfx::RectF(view->GetLocalBounds()), flags);
+
+  // Grain, anchored to the widget so it doesn't swim between views.
+  cc::PaintFlags grain;
+  SkMatrix offset = SkMatrix::Translate(-origin.x(), -origin.y());
+  grain.setShader(cc::PaintShader::MakeImage(
+      GrainTile(), SkTileMode::kRepeat,
+      SkTileMode::kRepeat, &offset));
+  canvas->DrawRect(gfx::RectF(view->GetLocalBounds()), grain);
+  return true;
+}
