+// Lightweight drawing of a parked Space's tab list (favicon + title rows),
+// shown next to the real list while the user swipes, so the neighbouring
+// Space slides in alongside instead of an empty gap. Rows mirror the vertical
+// tab metrics so the hand-off to the real list on release is seamless.
+class BibaSpacePreviewView : public views::View {
+  METADATA_HEADER(BibaSpacePreviewView, views::View)
+
+ public:
+  using Items = std::vector<std::pair<std::u16string, gfx::Image>>;
+
+  BibaSpacePreviewView();
+  BibaSpacePreviewView(const BibaSpacePreviewView&) = delete;
+  BibaSpacePreviewView& operator=(const BibaSpacePreviewView&) = delete;
+  ~BibaSpacePreviewView() override;
+
+  void SetItems(Items items, int first_row_y, int row_x, int row_pitch,
+                int row_height);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+ private:
+  Items items_;
+  // Geometry copied from the real tab list so rows line up.
+  int first_row_y_ = 0;
+  int row_x_ = 0;
+  int row_pitch_ = 0;
+  int row_height_ = 0;
+};
