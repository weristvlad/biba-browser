+
+BibaPinnedLinksView::BibaPinnedLinksView(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  prefs_.Init(browser_->GetProfile()->GetPrefs());
+  prefs_.Add(biba::prefs::kPinnedLinks,
+             base::BindRepeating(&BibaPinnedLinksView::Rebuild,
+                                 base::Unretained(this)));
+  if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+    space_changed_ = commands->BibaAddSpaceChangedCallback(base::BindRepeating(
+        [](BibaPinnedLinksView* self, int, int) { self->Rebuild(); },
+        base::Unretained(this)));
+  }
+  browser_->GetTabStripModel()->AddObserver(this);
+  Rebuild();
+}
+
+BibaPinnedLinksView::~BibaPinnedLinksView() {
+  if (browser_ && browser_->GetTabStripModel()) {
+    browser_->GetTabStripModel()->RemoveObserver(this);
+  }
+}
+
+// static
+void BibaPinnedLinksView::PinLink(BrowserWindowInterface* browser,
+                                  const GURL& url,
+                                  const std::u16string& title) {
+  if (!url.is_valid()) {
+    return;
+  }
+  const auto* commands = chrome::BrowserCommandController::From(browser);
+  const int space = commands ? commands->biba_active_space() : 0;
+  ScopedDictPrefUpdate update(browser->GetProfile()->GetPrefs(),
+                              biba::prefs::kPinnedLinks);
+  base::ListValue* list = update->EnsureList(SpaceKey(space));
+  for (const base::Value& item : *list) {
+    if (item.is_dict()) {
+      if (const std::string* existing = item.GetDict().FindString("url");
+          existing && SameLink(GURL(*existing), url)) {
+        return;
+      }
+    }
+  }
+  base::DictValue link;
+  link.Set("url", url.spec());
+  link.Set("title", base::UTF16ToUTF8(title));
+  list->Append(std::move(link));
+}
+
+int BibaPinnedLinksView::ActiveSpace() const {
+  const auto* commands = chrome::BrowserCommandController::From(browser_);
+  return commands ? commands->biba_active_space() : 0;
+}
+
+void BibaPinnedLinksView::Rebuild() {
+  links_.clear();
+  const base::DictValue& all =
+      browser_->GetProfile()->GetPrefs()->GetDict(biba::prefs::kPinnedLinks);
+  if (const base::ListValue* list = all.FindList(SpaceKey(ActiveSpace()))) {
+    for (const base::Value& item : *list) {
+      if (!item.is_dict()) {
+        continue;
+      }
+      const std::string* url = item.GetDict().FindString("url");
+      const std::string* title = item.GetDict().FindString("title");
+      GURL gurl(url ? *url : std::string());
+      if (gurl.is_valid()) {
+        links_.push_back(
+            {gurl, title ? base::UTF8ToUTF16(*title) : std::u16string()});
+      }
+    }
+  }
+  if (children().size() != links_.size()) {
+    RemoveAllChildViews();
+    for (size_t i = 0; i < links_.size(); ++i) {
+      AddChildView(std::make_unique<Row>(this, i));
+    }
+  }
+  const tabs::TabInterface* active =
+      browser_->GetTabStripModel()->GetActiveTab();
+  for (size_t i = 0; i < links_.size(); ++i) {
+    tabs::TabInterface* tab = TabFor(i);
+    content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+    gfx::Image favicon;
+    if (contents) {
+      if (auto* driver =
+              favicon::ContentFaviconDriver::FromWebContents(contents)) {
+        favicon = driver->GetFavicon();
+      }
+    }
+    std::u16string title = links_[i].title;
+    if (title.empty()) {
+      title = base::UTF8ToUTF16(links_[i].url.host());
+    }
+    static_cast<Row*>(children()[i])
+        ->SetState(title, favicon, tab && tab == active);
+  }
+  SetVisible(!links_.empty());
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+tabs::TabInterface* BibaPinnedLinksView::TabFor(size_t index) const {
+  const GURL& url = links_[index].url;
+  if (auto it = opened_.find(url.spec()); it != opened_.end()) {
+    if (tabs::TabInterface* tab = it->second.Get();
+        tab && browser_->GetTabStripModel()->GetIndexOfTab(tab) !=
+                   TabStripModel::kNoTab) {
+      return tab;
+    }
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    if (contents && SameLink(contents->GetLastCommittedURL(), url)) {
+      return model->GetTabAtIndex(i);
+    }
+  }
+  return nullptr;
+}
+
+void BibaPinnedLinksView::Open(size_t index) {
+  if (index >= links_.size()) {
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (tabs::TabInterface* tab = TabFor(index)) {
+    model->ActivateTabAt(model->GetIndexOfTab(tab));
+    return;
+  }
+  NavigateParams params(browser_.get(), links_[index].url,
+                        ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  if (params.navigated_or_inserted_contents) {
+    if (tabs::TabInterface* tab = tabs::TabInterface::GetFromContents(
+            params.navigated_or_inserted_contents)) {
+      opened_[links_[index].url.spec()] = tab->GetHandle();
+    }
+  }
+}
+
+void BibaPinnedLinksView::Remove(size_t index) {
+  if (index >= links_.size()) {
+    return;
+  }
+  const GURL url = links_[index].url;
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              biba::prefs::kPinnedLinks);
+  if (base::ListValue* list = update->FindList(SpaceKey(ActiveSpace()))) {
+    list->EraseIf([&url](const base::Value& item) {
+      const std::string* existing =
+          item.is_dict() ? item.GetDict().FindString("url") : nullptr;
+      return existing && GURL(*existing) == url;
+    });
+  }
+  opened_.erase(url.spec());
+}
+
+gfx::Size BibaPinnedLinksView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  if (links_.empty()) {
+    return gfx::Size();
+  }
+  const int height = static_cast<int>(links_.size()) * RowHeight() +
+                     2 * kDividerGap + 1;
+  return gfx::Size(available_size.width().value_or(200), height);
+}
+
+void BibaPinnedLinksView::Layout(PassKey) {
+  int y = 0;
+  for (views::View* row : children()) {
+    row->SetBounds(kRowPadding, y, width() - 2 * kRowPadding, RowHeight());
+    y += RowHeight();
+  }
+}
+
+void BibaPinnedLinksView::OnPaint(gfx::Canvas* canvas) {
+  // The divider between the links and the tabs.
+  if (links_.empty()) {
+    return;
+  }
+  const ui::ColorProvider* colors = GetColorProvider();
+  const bool dark =
+      colors && color_utils::IsDark(colors->GetColor(ui::kColorSysSurface));
+  const int y = static_cast<int>(links_.size()) * RowHeight() + kDividerGap;
+  canvas->FillRect(gfx::Rect(kRowPadding + 8, y, width() - 2 * (kRowPadding + 8),
+                             1),
+                   SkColorSetA(dark ? SK_ColorWHITE : SK_ColorBLACK, 0x1F));
+}
+
+void BibaPinnedLinksView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  Rebuild();
+}
+
+void BibaPinnedLinksView::OnTabChangedAt(tabs::TabInterface* tab,
+                                         TabChangeType change_type) {
+  Rebuild();
+}
