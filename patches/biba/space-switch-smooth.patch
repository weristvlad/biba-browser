+void BibaSpaceSwipeHandler::AnimateFrameBlendOut(int other, float amount,
+                                                 base::TimeDelta duration) {
+  blend_space_ = other;
+  blend_start_ = amount;
+  blend_animation_.SetSlideDuration(duration);
+  blend_animation_.SetTweenType(gfx::Tween::EASE_OUT);
+  blend_animation_.Reset(0.0);
+  blend_animation_.Show();
+}
+
+void BibaSpaceSwipeHandler::AnimationProgressed(
+    const gfx::Animation* animation) {
+  if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+    commands->BibaSetFrameBlend(
+        blend_space_,
+        blend_start_ * (1.0f - static_cast<float>(animation->GetCurrentValue())));
+  }
+}
+
+void BibaSpaceSwipeHandler::AnimationEnded(const gfx::Animation* animation) {
+  if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+    commands->BibaSetFrameBlend(-1, 0.0f);
+  }
+}
