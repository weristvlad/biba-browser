+#include "chrome/browser/ui/views/tabs/common/biba_drag_avatar.h"
+
+#include <utility>
+
+#include "cc/paint/paint_flags.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/transform.h"
+#include "ui/gfx/scoped_canvas.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/gfx/skia_paint_util.h"
+#include "ui/gfx/text_constants.h"
+
+namespace {
+
+// Dia's "firm" spring settles in about a quarter second.
+constexpr base::TimeDelta kMorphDuration = base::Milliseconds(240);
+constexpr base::TimeDelta kLandDuration = base::Milliseconds(220);
+constexpr int kCornerRadius = 10;
+constexpr int kIconSize = 16;
+constexpr int kIconInset = 9;
+constexpr int kTitleGap = 8;
+
+int Lerp(int a, int b, double t) {
+  return a + static_cast<int>((b - a) * t + (b > a ? 0.5 : -0.5));
+}
+
+}  // namespace
+
+BibaDragAvatar::BibaDragAvatar(gfx::ImageSkia favicon,
+                               std::u16string title,
+                               gfx::Size row_size,
+                               gfx::Size tile_size,
+                               bool tile,
+                               gfx::Vector2dF grab)
+    : favicon_(std::move(favicon)),
+      title_(std::move(title)),
+      row_size_(row_size),
+      tile_size_(tile_size),
+      grab_(grab) {
+  SetCanProcessEventsWithinSubtree(false);
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  morph_.SetSlideDuration(kMorphDuration);
+  morph_.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+  morph_.Reset(tile ? 1.0 : 0.0);
+  land_.SetSlideDuration(kLandDuration);
+  land_.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+}
+
+BibaDragAvatar::~BibaDragAvatar() = default;
+
+void BibaDragAvatar::MoveTo(const gfx::Point& pointer) {
+  pointer_ = pointer;
+  if (!land_.is_animating()) {
+    UpdateBounds();
+  }
+}
+
+void BibaDragAvatar::SetTile(bool tile) {
+  if (tile) {
+    morph_.Show();
+  } else {
+    morph_.Hide();
+  }
+}
+
+void BibaDragAvatar::FlyTo(const gfx::Rect& target,
+                           bool tile,
+                           base::OnceClosure done) {
+  land_from_ = bounds();
+  land_from_.Inset(kShadowMargin);
+  land_to_ = target;
+  land_done_ = std::move(done);
+  SetTile(tile);
+  land_.Reset(0.0);
+  land_.Show();
+}
+
+gfx::Rect BibaDragAvatar::ShapeRect() const {
+  gfx::Rect rect = GetLocalBounds();
+  rect.Inset(kShadowMargin);
+  return rect;
+}
+
+void BibaDragAvatar::UpdateBounds() {
+  gfx::Rect shape;
+  if (land_.is_animating() || land_.GetCurrentValue() > 0.0) {
+    shape = gfx::Tween::RectValueBetween(land_.GetCurrentValue(), land_from_,
+                                         land_to_);
+  } else {
+    const double m = morph_.GetCurrentValue();
+    const gfx::Size size(Lerp(row_size_.width(), tile_size_.width(), m),
+                         Lerp(row_size_.height(), tile_size_.height(), m));
+    shape = gfx::Rect(
+        pointer_.x() - static_cast<int>(grab_.x() * size.width()),
+        pointer_.y() - static_cast<int>(grab_.y() * size.height()),
+        size.width(), size.height());
+  }
+  shape.Outset(kShadowMargin);
+  SetBoundsRect(shape);
+  SchedulePaint();
+}
+
+void BibaDragAvatar::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  const bool dark =
+      colors && color_utils::IsDark(colors->GetColor(ui::kColorSysSurface));
+  const gfx::Rect shape = ShapeRect();
+  const double m = morph_.GetCurrentValue();
+
+  // Lifted card with a soft shadow.
+  cc::PaintFlags fill;
+  fill.setAntiAlias(true);
+  fill.setColor(dark ? SkColorSetRGB(0x3A, 0x3A, 0x40)
+                     : SkColorSetARGB(0xF5, 0xFF, 0xFF, 0xFF));
+  fill.setLooper(gfx::CreateShadowDrawLooper(
+      {gfx::ShadowValue(gfx::Vector2d(0, 4), 18,
+                        SkColorSetA(SK_ColorBLACK, dark ? 0x70 : 0x30))}));
+  canvas->DrawRoundRect(gfx::RectF(shape), kCornerRadius, fill);
+
+  // The icon slides from the row's leading edge to the tile's centre.
+  const int icon_x =
+      Lerp(shape.x() + kIconInset, shape.CenterPoint().x() - kIconSize / 2, m);
+  const int icon_y = shape.CenterPoint().y() - kIconSize / 2;
+  if (!favicon_.isNull()) {
+    canvas->DrawImageInt(favicon_, 0, 0, favicon_.width(), favicon_.height(),
+                         icon_x, icon_y, kIconSize, kIconSize,
+                         /*filter=*/true);
+  }
+
+  // The title fades out as the row becomes a tile.
+  const SkAlpha title_alpha = static_cast<SkAlpha>((1.0 - m) * 255);
+  if (title_alpha > 4 && !title_.empty()) {
+    gfx::ScopedCanvas clip(canvas);
+    canvas->ClipRect(shape);
+    const SkColor text = colors ? colors->GetColor(ui::kColorSysOnSurface)
+                                : SK_ColorBLACK;
+    const int text_x = icon_x + kIconSize + kTitleGap;
+    canvas->DrawStringRectWithFlags(
+        title_, gfx::FontList().DeriveWithSizeDelta(1),
+        SkColorSetA(text, title_alpha),
+        gfx::Rect(text_x, shape.y(), shape.right() - text_x - kIconInset,
+                  shape.height()),
+        gfx::Canvas::NO_SUBPIXEL_RENDERING);
+  }
+}
+
+void BibaDragAvatar::AnimationProgressed(const gfx::Animation* animation) {
+  UpdateBounds();
+}
+
+void BibaDragAvatar::AnimationEnded(const gfx::Animation* animation) {
+  UpdateBounds();
+  if (animation == &land_ && land_done_) {
+    std::move(land_done_).Run();
+  }
+}
+
+void BibaHideDraggedView(views::View* view) {
+  view->SetTransform(gfx::Transform());
+  if (!view->layer()) {
+    view->SetPaintToLayer();
+    view->layer()->SetFillsBoundsOpaquely(false);
+  }
+  view->layer()->SetOpacity(0.0f);
+}
+
