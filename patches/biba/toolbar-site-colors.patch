+class View;
+
+// Biba: gives `view` and its descendants their own ColorProvider (e.g. the
+// toolbar switching to dark colours over a dark page while the rest of the
+// window stays light). nullptr removes the override. The override goes away
+// by itself when `view` is deleted. Callers re-run OnThemeChanged() (e.g.
+// Widget::ThemeChanged()) so views pick the new colours up.
+VIEWS_EXPORT void SetBibaColorProviderOverride(View* view,
+                                               const ui::ColorProvider* provider);
+VIEWS_EXPORT const ui::ColorProvider* GetBibaColorProviderOverride(
+    const View* view);
+
+// The override that applies to `view`: its own or its nearest ancestor's.
+const ui::ColorProvider* FindBibaColorProviderOverride(const View* view);
+
+}  // namespace views
