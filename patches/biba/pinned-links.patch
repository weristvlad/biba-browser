+constexpr int kRowPadding = 6;       // Sidebar side padding, like the tabs.
+constexpr int kIconSize = 16;
+constexpr int kIconInset = 9;
+constexpr int kTitleGap = 8;
+constexpr int kCornerRadius = 10;
+constexpr int kDividerGap = 8;       // Above and below the divider.
+
+int RowHeight() {
+  return GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+}
+
+std::string SpaceKey(int space) {
+  return base::NumberToString(space);
+}
+
+// Two URLs are the same link when they point at the same page.
+bool SameLink(const GURL& a, const GURL& b) {
+  return a.host() == b.host() && a.path() == b.path();
+}
+
+}  // namespace
