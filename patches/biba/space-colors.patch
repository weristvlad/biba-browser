+void BrowserCommandController::RepaintBibaFrame() {
+  // The frame colour follows the active Space; repaint every frame surface.
+  views::Widget* widget =
+      browser_->GetWindow()
+          ? views::Widget::GetWidgetForNativeWindow(
+                browser_->GetWindow()->GetNativeWindow())
+          : nullptr;
+  if (!widget || !widget->GetRootView()) {
+    return;
+  }
+  std::vector<views::View*> pending = {widget->GetRootView()};
+  while (!pending.empty()) {
+    views::View* view = pending.back();
+    pending.pop_back();
+    view->SchedulePaint();
+    for (views::View* child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+}
