+int BibaSpaceSwitcherView::HitTestForDrag(const gfx::Point& point_in_screen) {
+  int hit = -1;
+  if (GetVisible() && GetWidget()) {
+    gfx::Point point = point_in_screen;
+    views::View::ConvertPointFromScreen(this, &point);
+    // A generous target: the whole row, plus some room above and below.
+    gfx::Rect target = GetLocalBounds();
+    target.Inset(gfx::Insets::VH(-kCellSize / 2, 0));
+    if (target.Contains(point)) {
+      const std::vector<int> spaces = VisibleSpaces();
+      const int first = FirstCellX(spaces.size());
+      const int cell = (point.x() - first) / kCellSize;
+      if (point.x() >= first && cell >= 0 &&
+          cell < static_cast<int>(spaces.size())) {
+        hit = spaces[cell];
+      }
+    }
+  }
+  if (hit != drag_hover_space_) {
+    drag_hover_space_ = hit;
+    SchedulePaint();
+  }
+  return hit;
+}
 
