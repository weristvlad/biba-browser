+// Copyright 2026 The Biba Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "ui/views/biba_color_override.h"
+
+#include <map>
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+
+namespace views {
+
+namespace {
+
+// Drops the override when its view goes away.
+class OverrideEntry : public ViewObserver {
+ public:
+  OverrideEntry(View* view, const ui::ColorProvider* provider)
+      : view_(view), provider_(provider) {
+    view_->AddObserver(this);
+  }
+  ~OverrideEntry() override {
+    if (view_) {
+      view_->RemoveObserver(this);
+    }
+  }
+
+  const ui::ColorProvider* provider() const { return provider_; }
+  void set_provider(const ui::ColorProvider* provider) { provider_ = provider; }
+
+  void OnViewIsDeleting(View* observed_view) override;
+
+ private:
+  raw_ptr<View> view_;
+  raw_ptr<const ui::ColorProvider> provider_;
+};
+
+std::map<const View*, std::unique_ptr<OverrideEntry>>& Overrides() {
+  static base::NoDestructor<std::map<const View*, std::unique_ptr<OverrideEntry>>>
+      overrides;
+  return *overrides;
+}
+
+void OverrideEntry::OnViewIsDeleting(View* observed_view) {
+  observed_view->RemoveObserver(this);
+  view_ = nullptr;
+  Overrides().erase(observed_view);  // Deletes `this`; nothing after.
+}
+
+}  // namespace
+
+void SetBibaColorProviderOverride(View* view,
+                                  const ui::ColorProvider* provider) {
+  auto& overrides = Overrides();
+  auto it = overrides.find(view);
+  if (!provider) {
+    if (it != overrides.end()) {
+      overrides.erase(it);
+    }
+    return;
+  }
+  if (it != overrides.end()) {
+    it->second->set_provider(provider);
+  } else {
+    overrides.emplace(view, std::make_unique<OverrideEntry>(view, provider));
+  }
+}
+
+const ui::ColorProvider* GetBibaColorProviderOverride(const View* view) {
+  const auto& overrides = Overrides();
+  auto it = overrides.find(view);
+  return it == overrides.end() ? nullptr : it->second->provider();
+}
+
+const ui::ColorProvider* FindBibaColorProviderOverride(const View* view) {
+  const auto& overrides = Overrides();
+  if (overrides.empty()) {
+    return nullptr;
+  }
+  for (const View* v = view; v; v = v->parent()) {
+    auto it = overrides.find(v);
+    if (it != overrides.end()) {
+      return it->second->provider();
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace views
