+std::vector<BibaSpacesController::PreviewItem> BibaSpacesController::GetPreview(
+    int index) const {
+  std::vector<PreviewItem> preview;
+  if (index < 0 || index >= kMaxSpaces || index == active_space_) {
+    return preview;
+  }
+  auto add = [&preview](const tabs::TabInterface* tab) {
+    content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+    if (!contents) {
+      return;
+    }
+    PreviewItem item;
+    item.title = contents->GetTitle();
+    if (auto* driver =
+            favicon::ContentFaviconDriver::FromWebContents(contents)) {
+      item.favicon = driver->GetFavicon();
+    }
+    preview.push_back(std::move(item));
+  };
+  for (const DetachedItem& item : spaces_[index].items) {
+    if (const auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&item)) {
+      add((*tab)->tab.get());
+    } else if (const auto* collection =
+                   std::get_if<std::unique_ptr<DetachedTabCollection>>(
+                       &item)) {
+      std::visit(
+          [&add](const auto& c) {
+            for (const tabs::TabInterface* t : c->GetTabsRecursive()) {
+              add(t);
+            }
+          },
+          (*collection)->collection_);
+    }
+  }
+  return preview;
+}
