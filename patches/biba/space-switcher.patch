+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_BIBA_SPACE_SWIPE_HANDLER_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_BIBA_SPACE_SWIPE_HANDLER_H_
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "ui/events/event_handler.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class View;
+}
+
+// Sidebar Space navigation:
+//  - a horizontal two-finger swipe over the sidebar moves to the previous /
+//    next Space in use;
+//  - whenever the Space changes (swipe, dots, Ctrl+1..9) the sidebar content
+//    slides in from the side the new Space lives on.
+// Installed as a pre-target handler on the sidebar so it sees horizontal
+// scrolls before the vertical tab list does.
+class BibaSpaceSwipeHandler : public ui::EventHandler {
+ public:
+  BibaSpaceSwipeHandler(BrowserWindowInterface* browser,
+                        views::View* sidebar_content);
+  BibaSpaceSwipeHandler(const BibaSpaceSwipeHandler&) = delete;
+  BibaSpaceSwipeHandler& operator=(const BibaSpaceSwipeHandler&) = delete;
+  ~BibaSpaceSwipeHandler() override;
+
+  // ui::EventHandler:
+  void OnScrollEvent(ui::ScrollEvent* event) override;
+
+ private:
+  void OnSpaceChanged(int from, int to);
+  // Next (+1) / previous (-1) Space in use, or -1 if there is none.
+  int NeighbourSpace(int direction) const;
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::View> sidebar_content_;
+  base::CallbackListSubscription space_changed_subscription_;
+
+  // Horizontal distance accumulated in the current gesture, in DIPs.
+  float accumulated_x_ = 0.0f;
+  // One Space change per gesture.
+  bool switched_this_gesture_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_BIBA_SPACE_SWIPE_HANDLER_H_
