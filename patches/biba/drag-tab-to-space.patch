 namespace {
 
+// Biba: Space dot under `point_in_screen` in `context`'s window, or -1.
+int BibaSpaceAt(TabDragContext* context, const gfx::Point& point_in_screen) {
+  if (!context || !context->GetWidget()) {
+    return -1;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForNativeWindow(
+      context->GetWidget()->GetNativeWindow());
+  auto* commands =
+      browser_view
+          ? chrome::BrowserCommandController::From(browser_view->browser())
+          : nullptr;
+  return commands ? commands->BibaSpaceAtScreenPoint(point_in_screen) : -1;
+}
