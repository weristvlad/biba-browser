+
+void BibaSpacesController::LoadState() {
+  Profile* profile = tab_strip_model_->profile();
+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  const base::FilePath path = profile->GetPath().AppendASCII(kStateFile);
+  if (!PersistingProfiles().insert(path).second) {
+    return;
+  }
+  state_path_ = path;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath path) -> std::optional<std::string> {
+            std::string json;
+            if (!base::ReadFileToString(path, &json)) {
+              return std::nullopt;
+            }
+            return json;
+          },
+          path),
+      base::BindOnce(&BibaSpacesController::OnStateLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void BibaSpacesController::OnStateLoaded(std::optional<std::string> json) {
+  // The user got there first; their choice wins over the saved state.
+  if (!json || switched_) {
+    return;
+  }
+  std::optional<base::Value> value =
+      base::JSONReader::Read(*json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return;
+  }
+  const base::Value::Dict& dict = value->GetDict();
+  const int active = dict.FindInt("active").value_or(0);
+  if (active < 0 || active >= kMaxSpaces) {
+    return;
+  }
+  if (const base::Value::List* spaces = dict.FindList("spaces")) {
+    for (size_t i = 0; i < spaces->size() && i < kMaxSpaces; ++i) {
+      if (static_cast<int>(i) == active || !(*spaces)[i].is_list()) {
+        continue;
+      }
+      for (const base::Value& tab : (*spaces)[i].GetList()) {
+        if (!tab.is_dict()) {
+          continue;
+        }
+        const std::string* url = tab.GetDict().FindString("url");
+        const std::string* title = tab.GetDict().FindString("title");
+        GURL gurl(url ? *url : std::string());
+        if (gurl.is_valid()) {
+          saved_[i].push_back(
+              {gurl, title ? base::UTF8ToUTF16(*title) : std::u16string()});
+        }
+      }
+    }
+  }
+  active_space_ = active;
+  if (on_space_changed_) {
+    on_space_changed_.Run();
+  }
+}
+
+void BibaSpacesController::SaveState() {
+  if (state_path_.empty()) {
+    return;
+  }
+  auto tab_value = [](const GURL& url, const std::u16string& title) {
+    base::Value::Dict tab;
+    tab.Set("url", url.spec());
+    tab.Set("title", base::UTF16ToUTF8(title));
+    return tab;
+  };
+  base::Value::List spaces;
+  for (int i = 0; i < kMaxSpaces; ++i) {
+    base::Value::List tabs;
+    if (i != active_space_) {
+      for (const SavedTab& saved : saved_[i]) {
+        tabs.Append(tab_value(saved.url, saved.title));
+      }
+      for (const tabs::TabInterface* tab : ParkedTabs(i)) {
+        content::WebContents* contents = tab->GetContents();
+        if (contents && contents->GetLastCommittedURL().is_valid()) {
+          tabs.Append(tab_value(contents->GetLastCommittedURL(),
+                                contents->GetTitle()));
+        }
+      }
+    }
+    spaces.Append(std::move(tabs));
+  }
+  base::Value::Dict state;
+  state.Set("version", 1);
+  state.Set("active", active_space_);
+  state.Set("spaces", std::move(spaces));
+  std::optional<std::string> json = base::WriteJsonWithOptions(
+      state, base::JSONWriter::OPTIONS_PRETTY_PRINT);
+  if (!json) {
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(
+          [](base::FilePath path, std::string json) {
+            base::ImportantFileWriter::WriteFileAtomically(path, json);
+          },
+          state_path_, std::move(*json)));
+}
+
+void BibaSpacesController::OpenSavedTabs(int index) {
+  std::vector<SavedTab> saved = std::move(saved_[index]);
+  saved_[index].clear();
+  TabStripModel* model = tab_strip_model_.get();
+  for (const SavedTab& tab : saved) {
+    model->delegate()->AddTabAt(tab.url, -1, /*foreground=*/false);
+  }
+}
+
+std::vector<const tabs::TabInterface*> BibaSpacesController::ParkedTabs(
+    int index) const {
+  std::vector<const tabs::TabInterface*> result;
+  for (const DetachedItem& item : spaces_[index].items) {
+    if (const auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&item)) {
+      result.push_back((*tab)->tab.get());
+    } else if (const auto* collection =
+                   std::get_if<std::unique_ptr<DetachedTabCollection>>(
+                       &item)) {
+      std::visit(
+          [&result](const auto& c) {
+            for (const tabs::TabInterface* t : c->GetTabsRecursive()) {
+              result.push_back(t);
+            }
+          },
+          (*collection)->collection_);
+    }
+  }
+  return result;
+}
 
