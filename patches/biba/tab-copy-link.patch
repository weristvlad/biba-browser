+// DEBUG: hovers the first sidebar tab; optionally clicks its copy-link button.
+void BibaPokeFirstTab(BrowserWindowInterface* browser, bool click_copy) {
+  if (!browser || !browser->GetWindow()) {
+    return;
+  }
+  views::Widget* widget = views::Widget::GetWidgetForNativeWindow(
+      browser->GetWindow()->GetNativeWindow());
+  if (!widget) {
+    return;
+  }
+  std::vector<views::View*> stack = {widget->GetRootView()};
+  while (!stack.empty()) {
+    views::View* view = stack.back();
+    stack.pop_back();
+    if (std::string_view(view->GetClassName()) == "TabView") {
+      const gfx::Point center = view->GetLocalBounds().CenterPoint();
+      ui::MouseEvent enter(ui::EventType::kMouseEntered, center, center,
+                           base::TimeTicks::Now(), 0, 0);
+      view->OnMouseEntered(enter);
+      if (click_copy) {
+        for (views::View* child : view->children()) {
+          auto* button = views::AsViewClass<views::ImageButton>(child);
+          if (button && button->GetVisible() &&
+              button->GetTooltipText() == u"Copy link") {
+            const gfx::Point c = button->GetLocalBounds().CenterPoint();
+            ui::MouseEvent press(ui::EventType::kMousePressed, c, c,
+                                 base::TimeTicks::Now(),
+                                 ui::EF_LEFT_MOUSE_BUTTON,
+                                 ui::EF_LEFT_MOUSE_BUTTON);
+            ui::MouseEvent release(ui::EventType::kMouseReleased, c, c,
+                                   base::TimeTicks::Now(),
+                                   ui::EF_LEFT_MOUSE_BUTTON,
+                                   ui::EF_LEFT_MOUSE_BUTTON);
+            button->OnMousePressed(press);
+            button->OnMouseReleased(release);
+            LOG(ERROR) << "[biba-selftest] clicked copy link";
+          }
+        }
+      }
+      return;
+    }
+    for (views::View* child : view->children()) {
+      stack.push_back(child);
+    }
+  }
+}
