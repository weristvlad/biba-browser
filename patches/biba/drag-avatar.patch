+// Biba (Dia/Arc): the floating copy of a tab dragged in the sidebar. It
+// follows the pointer and morphs between a tab row and a pinned tile as it
+// crosses between the list and the tiles, while the real tab stays in its
+// slot as a faint ghost and the others make room around it. On drop it flies
+// into the tab's final place.
+class BibaDragAvatar : public views::View, public gfx::AnimationDelegate {
+  METADATA_HEADER(BibaDragAvatar, views::View)
+
+ public:
+  // `grab` is where the pointer holds the tab, as a fraction of its size.
+  BibaDragAvatar(gfx::ImageSkia favicon,
+                 std::u16string title,
+                 gfx::Size row_size,
+                 gfx::Size tile_size,
+                 bool tile,
+                 gfx::Vector2dF grab);
+  BibaDragAvatar(const BibaDragAvatar&) = delete;
+  BibaDragAvatar& operator=(const BibaDragAvatar&) = delete;
+  ~BibaDragAvatar() override;
+
+  // Pointer position in the parent's coordinates.
+  void MoveTo(const gfx::Point& pointer);
+  // Morphs toward a tile (true) or a row (false).
+  void SetTile(bool tile);
+  // Flies to `target` (parent coordinates), then runs `done`.
+  void FlyTo(const gfx::Rect& target, bool tile, base::OnceClosure done);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+  // Room around the shape for its shadow.
+  static constexpr int kShadowMargin = 14;
+
+ private:
+  // The shape's rect (without shadow margin) for the current state.
+  gfx::Rect ShapeRect() const;
+  void UpdateBounds();
+
+  const gfx::ImageSkia favicon_;
+  const std::u16string title_;
+  const gfx::Size row_size_;
+  const gfx::Size tile_size_;
+  const gfx::Vector2dF grab_;
+  gfx::Point pointer_;
+
+  // 0 = row, 1 = tile.
+  gfx::SlideAnimation morph_{this};
+
+  // Landing: from the floating rect to `land_to_`.
+  gfx::SlideAnimation land_{this};
+  gfx::Rect land_from_;
+  gfx::Rect land_to_;
+  base::OnceClosure land_done_;
+};
+
+// True while a sidebar drag shows a BibaDragAvatar (defined in
+// tab_drag_handler.cc).
+bool BibaDragAvatarActive();
+
+// Keeps a dragged tab's real view in its slot but invisible (the avatar is
+// what the user sees).
+void BibaHideDraggedView(views::View* view);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_BIBA_DRAG_AVATAR_H_
