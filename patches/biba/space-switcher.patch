+// Copyright 2026 The Biba Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/biba_space_switcher_view.h"
+
+#include <vector>
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_command_controller.h"
+#include "chrome/browser/ui/views/frame/biba_frame_paint.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/events/event.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/views/accessibility/view_accessibility.h"
+
+namespace {
+
+// Each dot sits in a 24x24 cell so it stays easy to hit even though the dot
+// itself is small.
+constexpr int kCellSize = 24;
+constexpr float kDotRadius = 3.0f;
+constexpr float kActiveDotRadius = 3.5f;
+constexpr int kMaxSpaces = 9;
+// Inactive dots: white at 35% over the tinted frame.
+constexpr SkAlpha kInactiveAlpha = 0x59;
+
+}  // namespace
+
+BibaSpaceSwitcherView::BibaSpaceSwitcherView(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  GetViewAccessibility().SetRole(ax::mojom::Role::kTabList);
+  GetViewAccessibility().SetName(u"Spaces");
+}
+
+BibaSpaceSwitcherView::~BibaSpaceSwitcherView() = default;
+
+gfx::Size BibaSpaceSwitcherView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(kCellSize * static_cast<int>(VisibleSpaces().size()),
+                   kCellSize);
+}
+
+std::vector<int> BibaSpaceSwitcherView::VisibleSpaces() const {
+  std::vector<int> spaces;
+  const auto* commands = chrome::BrowserCommandController::From(browser_);
+  for (int i = 0; i < kMaxSpaces; ++i) {
+    if (commands ? commands->biba_space_in_use(i) : i == 0) {
+      spaces.push_back(i);
+    }
+  }
+  return spaces;
+}
+
+int BibaSpaceSwitcherView::FirstCellX(size_t count) const {
+  return (width() - kCellSize * static_cast<int>(count)) / 2;
+}
+
+void BibaSpaceSwitcherView::OnPaint(gfx::Canvas* canvas) {
+  const std::vector<int> spaces = VisibleSpaces();
+  const auto* commands = chrome::BrowserCommandController::From(browser_);
+  const int active = commands ? commands->biba_active_space() : 0;
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  int x = FirstCellX(spaces.size());
+  for (int space : spaces) {
+    const gfx::PointF center(x + kCellSize / 2.0f, height() / 2.0f);
+    if (space == active) {
+      // Lift the accent a little so the dot reads on its own tinted frame.
+      flags.setColor(color_utils::BlendTowardMaxContrast(
+          biba::SpaceAccentColor(space), 0x40));
+      canvas->DrawCircle(center, kActiveDotRadius, flags);
+    } else {
+      flags.setColor(SkColorSetA(SK_ColorWHITE, kInactiveAlpha));
+      canvas->DrawCircle(center, kDotRadius, flags);
+    }
+    x += kCellSize;
+  }
+}
+
+bool BibaSpaceSwitcherView::OnMousePressed(const ui::MouseEvent& event) {
+  const std::vector<int> spaces = VisibleSpaces();
+  const int cell = (event.x() - FirstCellX(spaces.size())) / kCellSize;
+  if (event.x() < FirstCellX(spaces.size()) || cell < 0 ||
+      cell >= static_cast<int>(spaces.size())) {
+    return false;
+  }
+  if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+    commands->ExecuteCommand(IDC_BIBA_SWITCH_SPACE_0 + spaces[cell]);
+  }
+  return true;
+}
+
+BEGIN_METADATA(BibaSpaceSwitcherView)
+END_METADATA
