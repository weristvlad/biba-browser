+// Biba (Dia): the toolbar takes the page's colour; over a page darker or
+// lighter than the window theme, the toolbar's icons and text switch to the
+// matching dark/light colours, the rest of the window keeps its own.
+void BibaMatchToolbarToPage(LocationBarView* location_bar) {
+  views::View* toolbar = location_bar->parent();
+  while (toolbar &&
+         std::string_view(toolbar->GetClassName()) != "ToolbarView") {
+    toolbar = toolbar->parent();
+  }
+  views::Widget* widget = location_bar->GetWidget();
+  if (!toolbar || !widget || !widget->GetColorProvider()) {
+    return;
+  }
+  const ui::ColorProvider* override = nullptr;
+  content::WebContents* contents = location_bar->GetWebContents();
+  std::optional<SkColor> site =
+      contents ? contents->GetThemeColor() : std::nullopt;
+  if (!site && contents) {
+    site = contents->GetBackgroundColor();
+  }
+  if (site && SkColorGetA(*site) == SK_AlphaOPAQUE) {
+    const bool window_dark = color_utils::IsDark(
+        widget->GetColorProvider()->GetColor(kColorToolbar));
+    const bool page_dark = color_utils::IsDark(*site);
+    if (page_dark != window_dark) {
+      ui::ColorProviderKey key = widget->GetColorProviderKeyForTesting();
+      key.color_mode = page_dark ? ui::ColorProviderKey::ColorMode::kDark
+                                 : ui::ColorProviderKey::ColorMode::kLight;
+      override = ui::ColorProviderManager::Get().GetColorProviderFor(key);
+    }
+  }
+  if (override != views::GetBibaColorProviderOverride(toolbar)) {
+    views::SetBibaColorProviderOverride(toolbar, override);
+    // Buttons cache colours when the theme changes; let them re-read.
+    widget->ThemeChanged();
+  }
+  toolbar->SchedulePaint();
+}
