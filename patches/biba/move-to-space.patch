+int BibaSpacesController::MoveTabsToSpace(const std::vector<int>& indices,
+                                          int index) {
+  if (index < 0) {
+    for (int i = 0; i < kMaxSpaces; ++i) {
+      if (!IsSpaceInUse(i)) {
+        index = i;
+        break;
+      }
+    }
+  }
+  if (index < 0 || index >= kMaxSpaces || index == active_space_) {
+    return -1;
+  }
+  TabStripModel* model = tab_strip_model_.get();
+  const int first_unpinned = model->IndexOfFirstNonPinnedTab();
+  std::vector<int> moving;
+  for (int i : indices) {
+    if (i >= first_unpinned && model->ContainsIndex(i)) {
+      moving.push_back(i);
+    }
+  }
+  if (moving.empty()) {
+    return -1;
+  }
+  std::sort(moving.begin(), moving.end());
+  // A strip that becomes empty closes its window: keep a fresh tab.
+  if (static_cast<int>(moving.size()) == model->count()) {
+    model->delegate()->AddTabAt(GURL(), -1, /*foreground=*/true);
+  }
+  Space& target = spaces_[index];
+  for (int i : moving) {
+    target.freeze_votes.push_back(
+        std::make_unique<performance_manager::freezing::FreezingVote>(
+            model->GetWebContentsAt(i)));
+  }
+  for (DetachedItem& item : model->DetachTabsAndCollectionsForInsertion(moving)) {
+    target.items.push_back(std::move(item));
+  }
+  SaveState();
+  return index;
+}
