+void TabView::BibaCopyLinkPressed() {
+  const tabs::TabInterface* tab = GetTabInterface();
+  if (!tab || !tab->GetContents()) {
+    return;
+  }
+  const GURL& url = tab->GetContents()->GetVisibleURL();
+  if (!url.is_valid()) {
+    return;
+  }
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+      .WriteText(base::UTF8ToUTF16(url.spec()));
+  // Static confirmation: the icon turns into a check for a moment.
+  BibaUpdateCopyLinkIcon(/*copied=*/true);
+  biba_copied_timer_.Start(
+      FROM_HERE, base::Milliseconds(1200),
+      base::BindOnce(&TabView::BibaUpdateCopyLinkIcon, base::Unretained(this),
+                     /*copied=*/false));
+}
+
+void TabView::BibaUpdateCopyLinkIcon(bool copied) {
+  if (!biba_copy_link_button_) {
+    return;
+  }
+  constexpr int kBibaCopyIconSize = 14;
+  biba_copy_link_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          copied ? kCheckIcon : vector_icons::kLinkIcon, biba_icon_color_,
+          kBibaCopyIconSize));
+}
