+// Biba: adds `contents`' page to the active Space's pinned links.
+void BibaPinTabAsLink(BrowserWindowInterface* browser,
+                      content::WebContents* contents) {
+  const GURL url = contents->GetLastCommittedURL();
+  if (!url.is_valid()) {
+    return;
+  }
+  const auto* commands = chrome::BrowserCommandController::From(browser);
+  const int space = commands ? std::max(0, commands->biba_active_space()) : 0;
+  ScopedDictPrefUpdate update(browser->GetProfile()->GetPrefs(),
+                              biba::prefs::kPinnedLinks);
+  base::ListValue* list = update->EnsureList(base::NumberToString(space));
+  for (const base::Value& item : *list) {
+    const std::string* existing =
+        item.is_dict() ? item.GetDict().FindString("url") : nullptr;
+    if (existing && GURL(*existing).host() == url.host() &&
+        GURL(*existing).path() == url.path()) {
+      return;
+    }
+  }
+  base::DictValue link;
+  link.Set("url", url.spec());
+  link.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  list->Append(std::move(link));
+}
