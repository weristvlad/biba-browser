+void BibaSpaceSwipeHandler::CommitSwipe(int target, int direction) {
+  const float width = std::max(1, sidebar_->width());
+  committing_to_ = target;
+  // Make sure the incoming picture is there even for a very short flick.
+  ShowPreview(target, offset_ + direction * width, handoff_opacity_);
+
+  // Old list out, new picture in: both are layer transforms/opacity, which
+  // run on the compositor.
+  gfx::Transform out;
+  out.Translate(-direction * width, 0);
+  views::AnimationBuilder builder;
+  builder
+      .SetPreemptionStrategy(
+          ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET)
+      .OnEnded(base::BindOnce(&BibaSpaceSwipeHandler::SwitchAfterSwipe,
+                              weak_factory_.GetWeakPtr()))
+      .OnAborted(base::BindOnce(&BibaSpaceSwipeHandler::SwitchAfterSwipe,
+                                weak_factory_.GetWeakPtr()));
+  auto& block = builder.Once().SetDuration(kSlideDuration);
+  for (views::View* view : MovableViews()) {
+    if (view->layer()) {
+      block.SetTransform(view->layer(), out, gfx::Tween::ACCEL_20_DECEL_100)
+          .SetOpacity(view->layer(), kMinOpacity, gfx::Tween::EASE_OUT);
+    }
+  }
+  block.SetTransform(preview_->layer(), gfx::Transform(),
+                     gfx::Tween::ACCEL_20_DECEL_100)
+      .SetOpacity(preview_->layer(), 1.0f, gfx::Tween::EASE_OUT);
+
+  // Frame colour flows the rest of the way to the new Space.
+  if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+    blend_space_ = target;
+    blend_start_ = commands->biba_frame_blend_amount();
+    blend_end_ = 1.0f;
+    blend_animation_.SetSlideDuration(kSlideDuration);
+    blend_animation_.SetTweenType(gfx::Tween::EASE_OUT);
+    blend_animation_.Reset(0.0);
+    blend_animation_.Show();
+  }
+}
+
+void BibaSpaceSwipeHandler::SwitchAfterSwipe() {
+  if (committing_to_ < 0) {
+    return;
+  }
+  const int target = committing_to_;
+  committing_to_ = -1;
+  // The picture now stands in for the list; the real list waits hidden at
+  // rest while Chromium moves the tabs and rebuilds it.
+  SetOffset(0.0f, 0.0f);
+  blend_animation_.Stop();
+  blend_end_ = 0.0f;
+  if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+    switch_after_swipe_ = true;
+    commands->BibaSetFrameBlend(-1, 0.0f);
+    commands->ExecuteCommand(IDC_BIBA_SWITCH_SPACE_0 + target);
+    switch_after_swipe_ = false;
+  }
+}
