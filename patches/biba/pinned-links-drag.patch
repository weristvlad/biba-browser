+void BibaPinnedLinksView::StartRowDrag(size_t index,
+                                       const std::u16string& title,
+                                       const gfx::Image& favicon,
+                                       const gfx::Point& grab_in_row) {
+  views::View* host = this;
+  while (host->parent() &&
+         std::string_view(host->GetClassName()) !=
+             "VerticalTabStripRegionView") {
+    host = host->parent();
+  }
+  const int row_width = width() - 2 * kRowPadding;
+  const gfx::Size row(row_width, RowHeight());
+  const gfx::Size tile(
+      std::max(GetLayoutConstant(LayoutConstant::kVerticalTabPinnedHeight),
+               (row_width - 12) / 3),
+      GetLayoutConstant(LayoutConstant::kVerticalTabPinnedHeight));
+  auto* avatar = host->AddChildView(std::make_unique<BibaDragAvatar>(
+      favicon.IsEmpty() ? gfx::ImageSkia() : *favicon.ToImageSkia(), title,
+      row, tile, /*tile=*/false,
+      gfx::Vector2dF(row_width ? float(grab_in_row.x()) / row_width : 0.5f,
+                     float(grab_in_row.y()) / RowHeight())));
+  avatar->SetProperty(views::kViewIgnoredByLayoutKey, true);
+  drag_avatar_.SetView(avatar);
+  if (index < children().size() && children()[index]->layer() == nullptr) {
+    children()[index]->SetPaintToLayer();
+    children()[index]->layer()->SetFillsBoundsOpaquely(false);
+  }
+  if (index < children().size()) {
+    children()[index]->layer()->SetOpacity(0.0f);
+  }
+}
+
+void BibaPinnedLinksView::UpdateRowDrag(const gfx::Point& point_in_screen) {
+  auto* avatar = static_cast<BibaDragAvatar*>(drag_avatar_.view());
+  if (!avatar || !avatar->parent()) {
+    return;
+  }
+  gfx::Point point = point_in_screen;
+  views::View::ConvertPointFromScreen(avatar->parent(), &point);
+  avatar->SetTile(point_in_screen.y() < GetBoundsInScreen().y());
+  avatar->MoveTo(point);
+}
+
+void BibaPinnedLinksView::CancelRowDrag() {
+  if (views::View* avatar = drag_avatar_.view(); avatar && avatar->parent()) {
+    avatar->parent()->RemoveChildViewT(avatar);
+  }
+  drag_avatar_.SetView(nullptr);
+  for (views::View* row : children()) {
+    row->DestroyLayer();
+  }
+}
+
+void BibaPinnedLinksView::EndRowDrag(size_t index,
+                                     const gfx::Point& point_in_screen) {
+  CancelRowDrag();
+  if (index >= links_.size()) {
+    return;
+  }
+  const gfx::Rect bounds = GetBoundsInScreen();
+  const Link link = links_[index];
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (point_in_screen.y() < bounds.y()) {
+    // Up onto the tiles: the link becomes a pinned tile.
+    tabs::TabInterface* tab = TabFor(index);
+    if (!tab) {
+      NavigateParams params(browser_.get(), link.url,
+                            ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+      params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      Navigate(&params);
+      tab = params.navigated_or_inserted_contents
+                ? tabs::TabInterface::GetFromContents(
+                      params.navigated_or_inserted_contents)
+                : nullptr;
+    }
+    Remove(index);
+    if (tab) {
+      const int tab_index = model->GetIndexOfTab(tab);
+      if (tab_index != TabStripModel::kNoTab) {
+        model->SetTabPinned(tab_index, true);
+      }
+    }
+    return;
+  }
+  if (point_in_screen.y() >= bounds.bottom() - kDividerGap) {
+    // Down into the list: unpin; an open tab simply shows in the list again.
+    Remove(index);
+    return;
+  }
+  // Within the links: reorder.
+  const int target = std::clamp(
+      (point_in_screen.y() - bounds.y()) / std::max(1, RowHeight()), 0,
+      static_cast<int>(links_.size()) - 1);
+  if (static_cast<size_t>(target) == index) {
+    return;
+  }
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              biba::prefs::kPinnedLinks);
+  if (base::ListValue* list = update->FindList(SpaceKey(ActiveSpace()));
+      list && index < list->size()) {
+    base::Value moved = (*list)[index].Clone();
+    list->erase(list->begin() + index);
+    list->Insert(list->begin() + target, std::move(moved));
+  }
+}
