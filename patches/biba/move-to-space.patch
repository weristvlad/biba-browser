+int TabStripModel::BibaActiveSpace() {
+  BrowserWindowInterface* const browser =
+      delegate()->GetBrowserWindowInterface();
+  auto* commands =
+      browser ? chrome::BrowserCommandController::From(browser) : nullptr;
+  return commands ? commands->biba_active_space() : -1;
+}
+
+bool TabStripModel::BibaSpaceInUse(int space) {
+  BrowserWindowInterface* const browser =
+      delegate()->GetBrowserWindowInterface();
+  auto* commands =
+      browser ? chrome::BrowserCommandController::From(browser) : nullptr;
+  return commands && commands->biba_space_in_use(space);
+}
+
+void TabStripModel::BibaMoveToSpace(int context_index, int space) {
+  if (!ContainsIndex(context_index)) {
+    return;
+  }
+  BrowserWindowInterface* const browser =
+      delegate()->GetBrowserWindowInterface();
+  if (auto* commands =
+          browser ? chrome::BrowserCommandController::From(browser)
+                  : nullptr) {
+    commands->BibaMoveTabsToSpace(GetIndicesForCommand(context_index), space);
+  }
+}
