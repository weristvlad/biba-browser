+// One link row: favicon + title, a soft pill while its tab is active, an
+// unpin "x" on hover.
+class BibaPinnedLinksView::Row : public views::Button {
+  METADATA_HEADER(Row, views::Button)
+
+ public:
+  Row(BibaPinnedLinksView* owner, size_t index)
+      : views::Button(base::BindRepeating(&Row::Pressed,
+                                          base::Unretained(this))),
+        owner_(owner),
+        index_(index) {
+    remove_ = AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(
+            [](BibaPinnedLinksView* owner, size_t index) {
+              owner->Remove(index);
+            },
+            owner, index),
+        vector_icons::kCloseChromeRefreshOldIcon, 14));
+    remove_->SetTooltipText(u"Unpin link");
+    remove_->SetVisible(false);
+  }
+
+  void SetState(std::u16string title, gfx::Image favicon, bool active) {
+    title_ = std::move(title);
+    favicon_ = std::move(favicon);
+    active_ = active;
+    GetViewAccessibility().SetName(title_);
+    SchedulePaint();
+  }
+
+  void Layout(PassKey) override {
+    const int size = 20;
+    remove_->SetBounds(width() - size - 8, (height() - size) / 2, size, size);
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    remove_->SetVisible(true);
+    views::Button::OnMouseEntered(event);
+    SchedulePaint();
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    remove_->SetVisible(false);
+    views::Button::OnMouseExited(event);
+    SchedulePaint();
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    const bool dark =
+        colors && color_utils::IsDark(colors->GetColor(ui::kColorSysSurface));
+    // Same veils as the tab rows (vertical_tab_style_views.cc).
+    float alpha = 0.0f;
+    if (active_) {
+      alpha = dark ? 0.14f : 0.85f;
+    } else if (IsMouseHovered()) {
+      alpha = dark ? 0.07f : 0.30f;
+    }
+    if (alpha > 0) {
+      cc::PaintFlags fill;
+      fill.setAntiAlias(true);
+      fill.setColor(SkColorSetA(SK_ColorWHITE,
+                                static_cast<U8CPU>(alpha * 255.0f)));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), kCornerRadius, fill);
+    }
+    const int icon_y = (height() - kIconSize) / 2;
+    if (!favicon_.IsEmpty()) {
+      canvas->DrawImageInt(*favicon_.ToImageSkia(), 0, 0, favicon_.Width(),
+                           favicon_.Height(), kIconInset, icon_y, kIconSize,
+                           kIconSize, /*filter=*/true);
+    } else if (colors) {
+      gfx::ScopedCanvas at_icon(canvas);
+      canvas->Translate(gfx::Vector2d(kIconInset, icon_y));
+      gfx::PaintVectorIcon(canvas, vector_icons::kGlobeIcon, kIconSize,
+                           colors->GetColor(ui::kColorIconSecondary));
+    }
+    const int text_x = kIconInset + kIconSize + kTitleGap;
+    const int text_right = remove_->GetVisible() ? remove_->x() - 4 : width() - 8;
+    canvas->DrawStringRectWithFlags(
+        title_, gfx::FontList().DeriveWithSizeDelta(1),
+        colors ? colors->GetColor(ui::kColorSysOnSurface) : SK_ColorBLACK,
+        gfx::Rect(text_x, 0, std::max(0, text_right - text_x), height()),
+        gfx::Canvas::NO_SUBPIXEL_RENDERING);
+  }
+
+ private:
+  void Pressed() { owner_->Open(index_); }
+
+  raw_ptr<BibaPinnedLinksView> owner_;
+  const size_t index_;
+  raw_ptr<views::ImageButton> remove_ = nullptr;
+  std::u16string title_;
+  gfx::Image favicon_;
+  bool active_ = false;
+};
