+void BrowserCommandController::BibaSetFrameBlend(int other_space,
+                                                 float amount) {
+  if (other_space < 0 || amount <= 0.0f) {
+    other_space = -1;
+    amount = 0.0f;
+  }
+  if (other_space == biba_frame_blend_space_ &&
+      amount == biba_frame_blend_amount_) {
+    return;
+  }
+  biba_frame_blend_space_ = other_space;
+  biba_frame_blend_amount_ = amount;
+  RepaintBibaFrame();
+}
+
 int BrowserCommandController::biba_active_space() const {
   return biba_spaces_ ? biba_spaces_->active_space() : 0;
 }
