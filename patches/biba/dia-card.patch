+// Soft drop shadow of the page card (toolbar + page) onto the frame. Every
+// frame view paints its slice in widget coordinates, so it reads as one.
+void PaintCardShadow(gfx::Canvas* canvas,
+                     const views::View* view,
+                     BrowserView* browser_view,
+                     bool dark) {
+  if (!browser_view->ShouldDrawVerticalTabStrip() ||
+      browser_view->IsFullscreen() || !browser_view->top_container() ||
+      !browser_view->multi_contents_view() ||
+      !browser_view->multi_contents_view()->GetVisible()) {
+    return;
+  }
+  gfx::Rect card = browser_view->top_container()->GetBoundsInScreen();
+  card.Union(browser_view->multi_contents_view()->GetBoundsInScreen());
+  // The page area inside MultiContentsView is inset; the card is what's
+  // visible: take its inner edges.
+  card.Inset(gfx::Insets::TLBR(0, 0, MultiContentsView::kSplitViewContentInset,
+                               0));
+  const gfx::Point view_origin = view->GetBoundsInScreen().origin();
+  card.Offset(-view_origin.x(), -view_origin.y());
+  if (!gfx::Rect(view->size()).Intersects(
+          gfx::Rect(card.x() - 24, card.y() - 24, card.width() + 48,
+                    card.height() + 48))) {
+    return;
+  }
+  const float radius =
+      GetLayoutConstant(LayoutConstant::kMainBackgroundRegionCornerRadius);
+  const SkRRect rrect =
+      SkRRect::MakeRectXY(gfx::RectToSkRect(card), radius, radius);
+  gfx::ScopedCanvas scoped(canvas);
+  canvas->sk_canvas()->clipRRect(rrect, SkClipOp::kDifference, true);
+  // The looper draws the blurred shadow; the shape itself is clipped away.
+  cc::PaintFlags shadow;
+  shadow.setAntiAlias(true);
+  shadow.setColor(SK_ColorBLACK);
+  shadow.setLooper(gfx::CreateShadowDrawLooper({gfx::ShadowValue(
+      gfx::Vector2d(0, 2), 18, SkColorSetA(SK_ColorBLACK, dark ? 0x66 : 0x38))}));
+  canvas->sk_canvas()->drawRRect(rrect, shadow);
+  // Hairline edge so the card holds its shape on light frames.
+  cc::PaintFlags edge;
+  edge.setAntiAlias(true);
+  edge.setStyle(cc::PaintFlags::kStroke_Style);
+  edge.setStrokeWidth(1.0f);
+  edge.setColor(SkColorSetA(SK_ColorBLACK, dark ? 0x40 : 0x14));
+  canvas->sk_canvas()->drawRRect(rrect, edge);
+}
