 extern const ui::ClassProperty<bool>* const kBibaTabInLinkKey;
 
+// The pinned links section of the sidebar in `any_view`'s window, in screen
+// coordinates, or nullopt if there is none. Dragging a tab above it makes a
+// pinned tile; dropping it on it makes a pinned link (Dia).
+inline std::optional<gfx::Rect> BibaPinnedLinksBoundsInScreen(
+    const views::View* any_view) {
+  const views::Widget* widget = any_view ? any_view->GetWidget() : nullptr;
+  if (!widget || !widget->GetRootView()) {
+    return std::nullopt;
+  }
+  std::vector<const views::View*> pending = {widget->GetRootView()};
+  while (!pending.empty()) {
+    const views::View* view = pending.back();
+    pending.pop_back();
+    if (std::string_view(view->GetClassName()) == "BibaPinnedLinksView") {
+      return view->GetVisible() ? std::optional(view->GetBoundsInScreen())
+                                : std::nullopt;
+    }
+    for (const views::View* child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+  return std::nullopt;
+}
+
