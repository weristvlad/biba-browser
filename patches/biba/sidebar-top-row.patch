+void BrowserView::LayoutBibaSpaceButton() {
+  if (!biba_space_button_) {
+    return;
+  }
+  const bool sidebar_visible =
+      vertical_tab_strip_region_view_ &&
+      vertical_tab_strip_region_view_->GetVisible() &&
+      !vertical_tab_strip_region_view_->bounds().IsEmpty();
+  biba_space_button_->SetVisible(sidebar_visible);
+  if (!sidebar_visible || !browser_widget_ || !browser_widget_->GetFrameView()) {
+    return;
+  }
+  // Just right of the traffic lights, centred on them.
+  const BrowserLayoutParams params =
+      browser_widget_->GetFrameView()->GetBrowserLayoutParams();
+  const gfx::SizeF exclusion = params.leading_exclusion.ContentWithPadding();
+  const gfx::Size size = biba_space_button_->GetPreferredSize();
+  const int x = base::ClampRound(params.visual_client_area.x() +
+                                 exclusion.width()) + 2;
+  const int y = base::ClampRound(params.visual_client_area.y() +
+                                 (exclusion.height() - size.height()) / 2.0f);
+  biba_space_button_->SetBoundsRect(gfx::Rect(gfx::Point(x, y), size));
+}
