+// Copyright 2026 The Biba Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/biba/biba_spaces_controller.h"
+
+#include <utility>
+
+#include "base/check_op.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "components/tabs/public/tab_group_tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "url/gurl.h"
+
+BibaSpacesController::Space::Space() = default;
+BibaSpacesController::Space::Space(Space&&) = default;
+BibaSpacesController::Space& BibaSpacesController::Space::operator=(Space&&) =
+    default;
+BibaSpacesController::Space::~Space() = default;
+
+BibaSpacesController::BibaSpacesController(TabStripModel* tab_strip_model)
+    : tab_strip_model_(tab_strip_model) {}
+
+BibaSpacesController::~BibaSpacesController() = default;
+
+void BibaSpacesController::SwitchToSpace(int index) {
+  if (index < 0 || index >= kMaxSpaces || index == active_space_) {
+    return;
+  }
+
+  TabStripModel* model = tab_strip_model_.get();
+  Space& current = spaces_[active_space_];
+  Space& target = spaces_[index];
+
+  // Remember what the outgoing Space looked like. Only unpinned tabs belong
+  // to a Space; pinned tabs stay put.
+  const int first_unpinned = model->IndexOfFirstNonPinnedTab();
+  const int old_count = model->count();
+  std::vector<int> outgoing;
+  for (int i = first_unpinned; i < old_count; ++i) {
+    outgoing.push_back(i);
+  }
+  tabs::TabInterface* active = model->GetActiveTab();
+  current.last_active_tab =
+      (active && model->GetIndexOfTab(active) >= first_unpinned) ? active
+                                                                 : nullptr;
+
+  // Bring the incoming Space in *before* removing the outgoing one: a strip
+  // that becomes empty closes its window. Appending keeps the indices in
+  // `outgoing` valid.
+  tabs::TabInterface* to_activate = AttachSpace(target);
+  if (model->count() == old_count) {
+    // Fresh Space (or one whose tabs were all closed): start with a new tab.
+    model->delegate()->AddTabAt(GURL(), -1, /*foreground=*/true);
+    to_activate = model->GetActiveTab();
+  }
+  if (to_activate) {
+    model->ActivateTabAt(model->GetIndexOfTab(to_activate));
+  }
+
+  // Park the outgoing Space.
+  current.items = model->DetachTabsAndCollectionsForInsertion(outgoing);
+  active_space_ = index;
+}
+
+tabs::TabInterface* BibaSpacesController::AttachSpace(Space& space) {
+  TabStripModel* model = tab_strip_model_.get();
+  tabs::TabInterface* first_attached = nullptr;
+
+  for (DetachedItem& item : space.items) {
+    if (auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&item)) {
+      tabs::TabInterface* tab_ptr = (*tab)->tab.get();
+      model->InsertDetachedTabAt(model->count(), std::move((*tab)->tab),
+                                 AddTabTypes::ADD_NONE);
+      if (!first_attached) {
+        first_attached = tab_ptr;
+      }
+    } else if (auto* collection =
+                   std::get_if<std::unique_ptr<DetachedTabCollection>>(
+                       &item)) {
+      const int insert_at = model->count();
+      if (std::holds_alternative<std::unique_ptr<tabs::TabGroupTabCollection>>(
+              (*collection)->collection_)) {
+        model->InsertDetachedTabGroupAt(std::move(*collection), insert_at);
+      } else {
+        model->InsertDetachedSplitTabAt(std::move(*collection), insert_at,
+                                        /*pinned=*/false);
+      }
+      if (!first_attached && insert_at < model->count()) {
+        first_attached = model->GetTabAtIndex(insert_at);
+      }
+    }
+  }
+  space.items.clear();
+
+  tabs::TabInterface* last_active = space.last_active_tab.get();
+  space.last_active_tab = nullptr;
+  if (last_active && model->GetIndexOfTab(last_active) != TabStripModel::kNoTab) {
+    return last_active;
+  }
+  return first_attached;
+}
