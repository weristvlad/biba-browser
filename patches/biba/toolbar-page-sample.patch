+// Colour of the top of the rendered page, per WebContents.
+struct PageTopSample : public base::SupportsUserData::Data {
+  std::optional<SkColor> color;
+  GURL url;
+  base::TimeTicks time;
+  bool pending = false;
+  // What the toolbar was last painted with, to skip needless repaints.
+  std::optional<SkColor> applied;
+};
+const char kPageTopSampleKey[] = "biba-page-top-sample";
+
+PageTopSample* GetSample(content::WebContents* contents, bool create) {
+  auto* sample =
+      static_cast<PageTopSample*>(contents->GetUserData(kPageTopSampleKey));
+  if (!sample && create) {
+    auto owned = std::make_unique<PageTopSample>();
+    sample = owned.get();
+    contents->SetUserData(kPageTopSampleKey, std::move(owned));
+  }
+  return sample;
+}
+
+// The most common colour along a row of pixels (headers are flat colours;
+// a logo or text in the strip shouldn't win).
+std::optional<SkColor> DominantColor(const SkBitmap& bitmap) {
+  if (bitmap.drawsNothing() || bitmap.width() == 0) {
+    return std::nullopt;
+  }
+  std::map<SkColor, int> counts;
+  for (int y = 0; y < bitmap.height(); ++y) {
+    for (int x = 0; x < bitmap.width(); ++x) {
+      const SkColor c = bitmap.getColor(x, y);
+      // Bucket to 4 bits per channel so anti-aliasing noise doesn't split it.
+      const SkColor bucket = SkColorSetRGB(SkColorGetR(c) & 0xF0,
+                                           SkColorGetG(c) & 0xF0,
+                                           SkColorGetB(c) & 0xF0);
+      ++counts[bucket];
+    }
+  }
+  SkColor best_bucket = SK_ColorWHITE;
+  int best = -1;
+  for (const auto& [bucket, count] : counts) {
+    if (count > best) {
+      best = count;
+      best_bucket = bucket;
+    }
+  }
+  // Return a real pixel from the winning bucket, not the bucket itself.
+  for (int x = 0; x < bitmap.width(); ++x) {
+    const SkColor c = bitmap.getColor(x, 0);
+    if (SkColorSetRGB(SkColorGetR(c) & 0xF0, SkColorGetG(c) & 0xF0,
+                      SkColorGetB(c) & 0xF0) == best_bucket) {
+      return SkColorSetA(c, SK_AlphaOPAQUE);
+    }
+  }
+  return SkColorSetA(best_bucket, SK_AlphaOPAQUE);
+}
+
+// Samples the top strip of the page, at most about once a second per tab.
+void MaybeSamplePageTop(content::WebContents* contents, views::View* toolbar) {
+  if (!contents) {
+    return;
+  }
+  content::RenderWidgetHostView* rwhv = contents->GetRenderWidgetHostView();
+  if (!rwhv || !rwhv->IsSurfaceAvailableForCopy()) {
+    return;
+  }
+  PageTopSample* sample = GetSample(contents, /*create=*/true);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (sample->pending || (sample->url == contents->GetVisibleURL() &&
+                          now - sample->time < base::Milliseconds(100))) {
+    return;
+  }
+  sample->pending = true;
+  const gfx::Size size = rwhv->GetViewBounds().size();
+  if (size.IsEmpty()) {
+    sample->pending = false;
+    return;
+  }
+  auto tracker = std::make_unique<views::ViewTracker>(toolbar);
+  rwhv->CopyFromSurface(
+      gfx::Rect(0, 0, size.width(), 2), gfx::Size(64, 1), base::Seconds(1),
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             std::unique_ptr<views::ViewTracker> tracker, GURL url,
+             const content::CopyFromSurfaceResult& result) {
+            if (!contents) {
+              return;
+            }
+            PageTopSample* sample = GetSample(contents.get(), true);
+            sample->pending = false;
+            sample->time = base::TimeTicks::Now();
+            sample->url = url;
+            if (result.has_value()) {
+              if (std::optional<SkColor> color =
+                      DominantColor(result->bitmap)) {
+                sample->color = color;
+              }
+            }
+            if (views::View* toolbar = tracker->view()) {
+              MatchToolbarToPage(toolbar, contents.get());
+            }
+          },
+          contents->GetWeakPtr(), std::move(tracker),
+          contents->GetVisibleURL()));
+}
+
+// The measured colour when it belongs to the page now shown; otherwise the
+// page's declared theme colour or background.
+std::optional<SkColor> PageTopColor(content::WebContents* contents) {
+  if (!contents) {
+    return std::nullopt;
+  }
+  if (PageTopSample* sample = GetSample(contents, /*create=*/false);
+      sample && sample->color && sample->url == contents->GetVisibleURL()) {
+    return sample->color;
+  }
+  std::optional<SkColor> site = contents->GetThemeColor();
+  if (!site) {
+    site = contents->GetBackgroundColor();
+  }
+  if (!site || SkColorGetA(*site) != SK_AlphaOPAQUE) {
+    return std::nullopt;
+  }
+  return site;
+}
