+namespace {
+DEFINE_UI_CLASS_PROPERTY_KEY(bool, kBibaLightsShownKey, false)
+// How far the lights are revealed, 0..1000 (animated).
+DEFINE_UI_CLASS_PROPERTY_KEY(int, kBibaLightsRevealKey, 0)
+}  // namespace
+
+// Watches the pointer in the window while the sidebar is hidden and reveals
+// the traffic lights near the top-leading corner.
+class BibaLightsRevealer : public ui::EventObserver,
+                           public gfx::AnimationDelegate {
+ public:
+  explicit BibaLightsRevealer(ToolbarView* toolbar) : toolbar_(toolbar) {
+    // Close to Dia's "firm" spring (0.25 s, damping 0.9).
+    reveal_.SetSlideDuration(base::Milliseconds(250));
+    reveal_.SetTweenType(gfx::Tween::EASE_OUT);
+    monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, toolbar->GetWidget()->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMouseExited,
+         ui::EventType::kMouseEntered});
+  }
+
+  void OnEvent(const ui::Event& event) override {
+    bool near = false;
+    if (event.type() != ui::EventType::kMouseExited && event.IsLocatedEvent()) {
+      gfx::Point point = event.AsLocatedEvent()->root_location();
+      views::View::ConvertPointFromWidget(toolbar_, &point);
+      const bool shown = toolbar_->GetProperty(kBibaLightsShownKey);
+      const int reach = shown ? biba::prefs::kTrafficLightsWidth + 24 : 56;
+      near = point.y() < toolbar_->height() + 6 && point.x() < reach;
+    }
+    if (near != toolbar_->GetProperty(kBibaLightsShownKey)) {
+      toolbar_->SetProperty(kBibaLightsShownKey, near);
+      if (near) {
+        reveal_.Show();
+      } else {
+        reveal_.Hide();
+      }
+    }
+  }
+
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    toolbar_->SetProperty(
+        kBibaLightsRevealKey,
+        static_cast<int>(animation->GetCurrentValue() * 1000));
+    toolbar_->InvalidateLayout();
+  }
+
+ private:
+  raw_ptr<ToolbarView> toolbar_;
+  gfx::SlideAnimation reveal_{this};
+  std::unique_ptr<views::EventMonitor> monitor_;
+};
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(BibaLightsRevealer*)
+
+namespace {
+
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(BibaLightsRevealer, kBibaLightsRevealerKey)
+
+void BibaUpdateTrafficLights(ToolbarView* toolbar) {
+  BrowserWindowInterface* browser = toolbar->browser();
+  views::Widget* widget = toolbar->GetWidget();
+  if (!browser || !widget) {
+    return;
+  }
+  const bool hidden_sidebar =
+      browser->GetProfile()->GetPrefs()->GetBoolean(
+          biba::prefs::kSidebarHidden) &&
+      !widget->IsFullscreen();
+  if (hidden_sidebar && !toolbar->GetProperty(kBibaLightsRevealerKey)) {
+    toolbar->SetProperty(kBibaLightsRevealerKey,
+                         std::make_unique<BibaLightsRevealer>(toolbar));
+  } else if (!hidden_sidebar && toolbar->GetProperty(kBibaLightsRevealerKey)) {
+    toolbar->ClearProperty(kBibaLightsRevealerKey);
+    toolbar->SetProperty(kBibaLightsShownKey, false);
+    toolbar->SetProperty(kBibaLightsRevealKey, 0);
+  }
+  const float reveal =
+      hidden_sidebar ? toolbar->GetProperty(kBibaLightsRevealKey) / 1000.0f
+                     : 1.0f;
+  if (auto* frame_view = static_cast<BrowserFrameView*>(
+          widget->non_client_view() ? widget->non_client_view()->frame_view()
+                                    : nullptr)) {
+    frame_view->SetCaptionButtonsOpacity(reveal);
+  }
+}
