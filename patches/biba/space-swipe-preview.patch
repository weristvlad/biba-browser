+void BibaSpaceSwipeHandler::ShowPreview(int space, float offset,
+                                        float opacity) {
+  if (!preview_) {
+    return;
+  }
+  if (space != preview_space_) {
+    preview_space_ = space;
+    // Copy the real rows' geometry so the preview lines up with them.
+    std::vector<gfx::Rect> rows;
+    std::vector<views::View*> pending = movable_views_.Run();
+    while (!pending.empty()) {
+      views::View* view = pending.back();
+      pending.pop_back();
+      if (std::string_view(view->GetClassName()) == "TabView") {
+        gfx::RectF r(view->GetLocalBounds());
+        views::View::ConvertRectToTarget(view, sidebar_, &r);
+        rows.push_back(gfx::ToEnclosingRect(r));
+        continue;
+      }
+      for (views::View* child : view->children()) {
+        pending.push_back(child);
+      }
+    }
+    std::sort(rows.begin(), rows.end(),
+              [](const gfx::Rect& a, const gfx::Rect& b) { return a.y() < b.y(); });
+    const gfx::Rect first = rows.empty() ? gfx::Rect(8, 48, 0, 36) : rows[0];
+    const int pitch =
+        rows.size() > 1 ? rows[1].y() - rows[0].y() : first.height() + 4;
+    std::vector<std::pair<std::u16string, gfx::Image>> items;
+    if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+      items = commands->biba_space_preview(space);
+    }
+    preview_->SetBoundsRect(sidebar_->GetLocalBounds());
+    preview_->SetItems(std::move(items), first.y(), first.x(), pitch,
+                       first.height());
+  }
+  if (!preview_->layer()) {
+    preview_->SetPaintToLayer();
+    preview_->layer()->SetFillsBoundsOpaquely(false);
+  }
+  preview_->SetVisible(true);
+  preview_->layer()->GetAnimator()->StopAnimating();
+  gfx::Transform transform;
+  transform.Translate(offset, 0);
+  preview_->layer()->SetTransform(transform);
+  preview_->layer()->SetOpacity(opacity);
+}
+
+void BibaSpaceSwipeHandler::HidePreview() {
+  if (preview_) {
+    preview_->SetVisible(false);
+  }
+  preview_space_ = -1;
+}
