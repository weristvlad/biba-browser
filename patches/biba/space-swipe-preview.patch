+namespace {
+
+// Mirrors TabViewVerticalLayout: 16px favicon at a 7px inset, title 4px after.
+constexpr int kIconSize = 16;
+constexpr int kIconInset = 7;
+constexpr int kTitleGap = 8;
+constexpr int kRightInset = 8;
+
+}  // namespace
+
+BibaSpacePreviewView::BibaSpacePreviewView() {
+  SetCanProcessEventsWithinSubtree(false);
+}
+
+BibaSpacePreviewView::~BibaSpacePreviewView() = default;
+
+void BibaSpacePreviewView::SetItems(Items items,
+                                    int first_row_y,
+                                    int row_x,
+                                    int row_pitch,
+                                    int row_height) {
+  items_ = std::move(items);
+  first_row_y_ = first_row_y;
+  row_x_ = row_x;
+  row_pitch_ = row_pitch;
+  row_height_ = row_height;
+  SchedulePaint();
+}
+
+void BibaSpacePreviewView::OnPaint(gfx::Canvas* canvas) {
+  const SkColor text_color =
+      GetColorProvider()->GetColor(ui::kColorSysOnSurface);
+  const gfx::FontList font_list;
+  int y = first_row_y_;
+  for (const auto& [title, favicon] : items_) {
+    const int icon_x = row_x_ + kIconInset;
+    const int icon_y = y + (row_height_ - kIconSize) / 2;
+    if (!favicon.IsEmpty()) {
+      canvas->DrawImageInt(*favicon.ToImageSkia(), 0, 0,
+                           favicon.Width(), favicon.Height(), icon_x, icon_y,
+                           kIconSize, kIconSize, /*filter=*/true);
+    }
+    const int text_x = icon_x + kIconSize + kTitleGap;
+    canvas->DrawStringRectWithFlags(
+        title, font_list, text_color,
+        gfx::Rect(text_x, y, width() - text_x - kRightInset, row_height_),
+        gfx::Canvas::NO_SUBPIXEL_RENDERING);
+    y += row_pitch_;
+  }
+}
