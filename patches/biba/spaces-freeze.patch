+void BibaSpaceSwipeHandler::SetOffset(float offset, float opacity) {
+  offset_ = offset;
+  gfx::Transform transform;
+  transform.Translate(offset, 0);
+  for (views::View* view : movable_views_.Run()) {
+    if (!view->layer()) {
+      view->SetPaintToLayer();
+      view->layer()->SetFillsBoundsOpaquely(false);
+    }
+    view->layer()->GetAnimator()->StopAnimating();
+    view->layer()->SetTransform(transform);
+    view->layer()->SetOpacity(opacity);
+  }
+}
+
+void BibaSpaceSwipeHandler::AnimateToRest(base::TimeDelta duration) {
+  offset_ = 0.0f;
+  views::AnimationBuilder builder;
+  builder.SetPreemptionStrategy(
+      ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+  auto& block = builder.Once().SetDuration(duration);
+  for (views::View* view : movable_views_.Run()) {
+    if (!view->layer()) {
+      continue;
+    }
+    block.SetTransform(view->layer(), gfx::Transform(),
+                       gfx::Tween::ACCEL_20_DECEL_100)
+        .SetOpacity(view->layer(), 1.0f, gfx::Tween::EASE_OUT);
+  }
+}
+
