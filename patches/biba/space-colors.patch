+// DEBUG: dumps the views under widget point (x, y), outermost first.
+void BibaDumpViewsAt(BrowserWindowInterface* browser, int x, int y) {
+  if (!browser || !browser->GetWindow()) {
+    return;
+  }
+  views::Widget* widget = views::Widget::GetWidgetForNativeWindow(
+      browser->GetWindow()->GetNativeWindow());
+  if (!widget) {
+    return;
+  }
+  std::vector<std::pair<views::View*, int>> stack = {{widget->GetRootView(), 0}};
+  while (!stack.empty()) {
+    auto [view, depth] = stack.back();
+    stack.pop_back();
+    gfx::Point p(x, y);
+    views::View::ConvertPointFromWidget(view, &p);
+    if (!view->GetLocalBounds().Contains(p) || !view->GetVisible()) {
+      continue;
+    }
+    LOG(ERROR) << "[biba-views] " << std::string(depth * 2, ' ')
+               << view->GetClassName() << " " << view->bounds().ToString()
+               << (view->background() ? " BG" : "")
+               << (view->layer() ? " LAYER" : "");
+    for (views::View* child : view->children()) {
+      stack.push_back({child, depth + 1});
+    }
+  }
+}
