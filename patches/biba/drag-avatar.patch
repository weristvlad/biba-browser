+
+int TabDragHandlerImpl::BibaTileLine() const {
+  auto* tab_strip_view = views::AsViewClass<TabStripView>(
+      tab_strip_region_view_->GetTabStripView());
+  if (!tab_strip_view || !tab_strip_view->unpinned_tabs_scroll_view()) {
+    return 0;
+  }
+  return tab_strip_view->unpinned_tabs_scroll_view()->GetBoundsInScreen().y() +
+         GetLayoutConstant(LayoutConstant::kVerticalTabHeight) / 2;
+}
+
+void TabDragHandlerImpl::BibaStartAvatar() {
+  views::View* region = &tab_strip_region_view_.get();
+  if (std::string_view(region->GetClassName()) !=
+          "VerticalTabStripRegionView" ||
+      !drag_controller_) {
+    return;
+  }
+  const DragSessionData& data = drag_controller_->GetSessionData();
+  if (!data.dragging_groups.empty() || !data.source_view_drag_data() ||
+      !data.source_view_drag_data()->contents ||
+      !IsLiveSlotView(data.source_view_drag_data()->attached_view)) {
+    return;
+  }
+  content::WebContents* contents = data.source_view_drag_data()->contents;
+  views::View* source_view =
+      ViewFromTabSlot(data.source_view_drag_data()->attached_view);
+  if (!source_view) {
+    return;
+  }
+  const gfx::Rect source = source_view->GetBoundsInScreen();
+  const gfx::Point cursor = display::Screen::Get()->GetCursorScreenPoint();
+  const gfx::Vector2dF grab(
+      source.width() ? std::clamp(float(cursor.x() - source.x()) /
+                                      source.width(), 0.0f, 1.0f)
+                     : 0.5f,
+      source.height() ? std::clamp(float(cursor.y() - source.y()) /
+                                       source.height(), 0.0f, 1.0f)
+                      : 0.5f);
+  const bool pinned = data.source_view_drag_data()->pinned;
+  const int row_height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+  const int tile_height =
+      GetLayoutConstant(LayoutConstant::kVerticalTabPinnedHeight);
+  auto* tab_strip_view = views::AsViewClass<TabStripView>(
+      tab_strip_region_view_->GetTabStripView());
+  const int row_width = tab_strip_view && tab_strip_view->unpinned_tabs_scroll_view()
+                            ? tab_strip_view->unpinned_tabs_scroll_view()->width() - 12
+                            : source.width();
+  const gfx::Size row_size(pinned ? row_width : source.width(), row_height);
+  const gfx::Size tile_size(
+      pinned ? source.width() : std::max(tile_height, (row_width - 12) / 3),
+      tile_height);
+  gfx::ImageSkia favicon;
+  if (auto* driver = favicon::ContentFaviconDriver::FromWebContents(contents)) {
+    favicon = driver->GetFavicon().AsImageSkia();
+  }
+  auto* avatar = region->AddChildView(std::make_unique<BibaDragAvatar>(
+      favicon, contents->GetTitle(), row_size, tile_size, pinned, grab));
+  avatar->SetProperty(views::kViewIgnoredByLayoutKey, true);
+  biba_avatar_.SetView(avatar);
+  g_biba_avatar_active = true;
+  BibaUpdateAvatar(cursor);
+}
+
+void TabDragHandlerImpl::BibaUpdateAvatar(const gfx::Point& point_in_screen) {
+  auto* avatar = static_cast<BibaDragAvatar*>(biba_avatar_.view());
+  if (!avatar || !avatar->parent()) {
+    return;
+  }
+  gfx::Point point = point_in_screen;
+  views::View::ConvertPointFromScreen(avatar->parent(), &point);
+  avatar->SetTile(point_in_screen.y() < BibaTileLine());
+  avatar->MoveTo(point);
+}
+
+void TabDragHandlerImpl::BibaLandAvatar() {
+  g_biba_avatar_active = false;
+  auto* avatar = static_cast<BibaDragAvatar*>(biba_avatar_.view());
+  biba_avatar_.SetView(nullptr);
+  if (!avatar || !avatar->parent()) {
+    return;
+  }
+  views::View* parent = avatar->parent();
+  auto remove = base::BindOnce(
+      [](std::unique_ptr<views::ViewTracker> tracker) {
+        if (views::View* view = tracker->view(); view && view->parent()) {
+          view->parent()->RemoveChildViewT(view);
+        }
+      },
+      std::make_unique<views::ViewTracker>(avatar));
+  // Land where the tab ended up.
+  gfx::Rect target;
+  bool tile = false;
+  if (drag_controller_) {
+    const DragSessionData& data = drag_controller_->GetSessionData();
+    if (data.source_view_drag_data() && data.source_view_drag_data()->contents) {
+      tabs::TabInterface* tab = tabs::TabInterface::GetFromContents(
+          data.source_view_drag_data()->contents);
+      TabCollectionNode* node =
+          tab ? root_node_->GetNodeForHandle(tab->GetHandle()) : nullptr;
+      if (node && node->view()) {
+        biba_landing_view_.SetView(node->view());
+        BibaHideDraggedView(node->view());
+        target = node->view()->GetBoundsInScreen();
+        gfx::Point origin = target.origin();
+        views::View::ConvertPointFromScreen(parent, &origin);
+        target.set_origin(origin);
+        tile = tab->IsPinned();
+      }
+    }
+  }
+  if (target.IsEmpty()) {
+    std::move(remove).Run();
+    return;
+  }
+  // Reveal the real tab only once the avatar has landed on it.
+  auto reveal = base::BindOnce(
+      [](std::unique_ptr<views::ViewTracker> landing) {
+        if (views::View* view = landing->view()) {
+          view->DestroyLayer();
+        }
+      },
+      std::make_unique<views::ViewTracker>(biba_landing_view_.view()));
+  avatar->FlyTo(target, tile, std::move(remove).Then(std::move(reveal)));
+}
