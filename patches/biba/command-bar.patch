+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace {
+
+constexpr int kBarWidth = 640;
+constexpr int kCornerRadius = 16;
+
+class BibaCommandBarView : public views::View,
+                           public views::TextfieldController,
+                           public views::WidgetObserver {
+  METADATA_HEADER(BibaCommandBarView, views::View)
+
+ public:
+  explicit BibaCommandBarView(BrowserWindowInterface* browser)
+      : browser_(browser) {
+    SetBackground(views::CreateRoundedRectBackground(ui::kColorDialogBackground,
+                                                     kCornerRadius));
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(14, 18)));
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+                         views::BoxLayout::Orientation::kHorizontal,
+                         gfx::Insets(), 12))
+        ->set_cross_axis_alignment(
+            views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    AddChildView(std::make_unique<views::ImageView>(
+        ui::ImageModel::FromVectorIcon(vector_icons::kSearchIcon,
+                                       ui::kColorIconSecondary, 20)));
+    textfield_ = AddChildView(std::make_unique<views::Textfield>());
+    textfield_->SetPlaceholderText(u"Search or enter address");
+    textfield_->SetBorder(nullptr);
+    textfield_->SetBackground(nullptr);
+    textfield_->SetFontList(gfx::FontList().DeriveWithSizeDelta(5));
+    textfield_->set_controller(this);
+    textfield_->SetPreferredSize(gfx::Size(kBarWidth - 80, 32));
+    textfield_->GetViewAccessibility().SetName(u"Search or enter address");
+  }
+  BibaCommandBarView(const BibaCommandBarView&) = delete;
+  BibaCommandBarView& operator=(const BibaCommandBarView&) = delete;
+  ~BibaCommandBarView() override = default;
+
+  views::Textfield* textfield() { return textfield_; }
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    if (key_event.key_code() == ui::VKEY_ESCAPE) {
+      GetWidget()->Close();
+      return true;
+    }
+    if (key_event.key_code() == ui::VKEY_RETURN) {
+      Open(std::u16string(sender->GetText()));
+      return true;
+    }
+    return false;
+  }
+
+  // views::WidgetObserver: clicking elsewhere closes the bar.
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (!active) {
+      widget->RemoveObserver(this);
+      widget->Close();
+    }
+  }
+
+ private:
+  void Open(const std::u16string& text) {
+    if (text.empty() || !browser_) {
+      return;
+    }
+    // Same rules as the address bar: addresses open, anything else is a
+    // search with the default engine. No AI.
+    AutocompleteMatch match;
+    AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile())
+        ->Classify(text, /*in_keyword_mode=*/false,
+                   /*allow_exact_keyword_match=*/true,
+                   metrics::OmniboxEventProto::INVALID_SPEC, &match, nullptr);
+    if (!match.destination_url.is_valid()) {
+      return;
+    }
+    NavigateParams params(browser_.get(), match.destination_url,
+                          ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::CURRENT_TAB;
+    GetWidget()->Close();
+    Navigate(&params);
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Textfield> textfield_ = nullptr;
+};
+
+BEGIN_METADATA(BibaCommandBarView)
+END_METADATA
+
+}  // namespace
+
+namespace biba {
+
+bool ShowCommandBar(BrowserWindowInterface* browser) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  views::Widget* parent = browser_view ? browser_view->GetWidget() : nullptr;
+  if (!parent || !browser_view->multi_contents_view()) {
+    return false;
+  }
+  auto contents = std::make_unique<BibaCommandBarView>(browser);
+  BibaCommandBarView* bar = contents.get();
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent->GetNativeView();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+  params.rounded_corners = gfx::RoundedCornersF(kCornerRadius);
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.name = "BibaCommandBar";
+  const gfx::Rect page =
+      browser_view->multi_contents_view()->GetBoundsInScreen();
+  const gfx::Size size = bar->GetPreferredSize();
+  params.bounds = gfx::Rect(page.CenterPoint().x() - size.width() / 2,
+                            page.y() + page.height() / 4, size.width(),
+                            size.height());
+
+  // The widget deletes itself (and the bar) when closed.
+  auto* widget = new views::Widget();
+  params.ownership = views::Widget::InitParams::WIDGET_OWNS_NATIVE_WIDGET;
+  widget->Init(std::move(params));
+  widget->SetContentsView(std::move(contents));
+  widget->AddObserver(bar);
+  widget->Show();
+  widget->Activate();
+  bar->textfield()->RequestFocus();
+  return true;
+}
+
+}  // namespace biba
