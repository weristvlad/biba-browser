+  const int target = biba_spaces_->MoveTabsToSpace(indices, space);
+  if (target >= 0) {
+    // Same index twice: "Space `target` changed while hidden".
+    biba_space_changed_callbacks_.Notify(target, target);
+    RepaintBibaFrame();
+  }
+}
