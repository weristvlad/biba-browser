+// Biba (Dia): pinned links. Rows between the pinned tiles and the tab list,
+// with a divider under them. A link stays in the sidebar when its tab is
+// closed; clicking it switches to its tab, or opens it again. Each Space has
+// its own links (pref biba::prefs::kPinnedLinks).
+class BibaPinnedLinksView : public views::View, public TabStripModelObserver {
+  METADATA_HEADER(BibaPinnedLinksView, views::View)
+
+ public:
+  explicit BibaPinnedLinksView(BrowserWindowInterface* browser);
+  BibaPinnedLinksView(const BibaPinnedLinksView&) = delete;
+  BibaPinnedLinksView& operator=(const BibaPinnedLinksView&) = delete;
+  ~BibaPinnedLinksView() override;
+
+  // Adds `url` to the active Space's links (no-op if it's already there).
+  static void PinLink(BrowserWindowInterface* browser,
+                      const GURL& url,
+                      const std::u16string& title);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
