+// Implemented by the pinned links section: lets a tab drag show where the
+// tab would land (rows part to make room) and drop it there.
+class BibaLinksDropTarget {
+ public:
+  // `y_in_screen`: pointer height while a tab hovers the links, or nullopt.
+  virtual void SetDropHover(std::optional<int> y_in_screen) = 0;
+  // Pins `contents` as a link at the hovered position.
+  virtual void DropTab(content::WebContents* contents) = 0;
+
+ protected:
+  virtual ~BibaLinksDropTarget() = default;
+};
+DECLARE_UI_CLASS_PROPERTY_TYPE(BibaLinksDropTarget*)
+extern const ui::ClassProperty<BibaLinksDropTarget*>* const
+    kBibaLinksDropTargetKey;
+
+// The links section's drop target in `any_view`'s window, if any.
+inline BibaLinksDropTarget* BibaFindLinksDropTarget(
+    const views::View* any_view) {
+  const views::Widget* widget = any_view ? any_view->GetWidget() : nullptr;
+  if (!widget || !widget->GetRootView()) {
+    return nullptr;
+  }
+  std::vector<const views::View*> pending = {widget->GetRootView()};
+  while (!pending.empty()) {
+    const views::View* view = pending.back();
+    pending.pop_back();
+    if (BibaLinksDropTarget* target = view->GetProperty(kBibaLinksDropTargetKey)) {
+      return target;
+    }
+    for (const views::View* child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+  return nullptr;
+}
