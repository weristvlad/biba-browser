+
+void BibaPinnedLinksView::HideLinkedTabsFromList() {
+  std::set<const tabs::TabInterface*> linked;
+  for (size_t i = 0; i < links_.size(); ++i) {
+    if (const tabs::TabInterface* tab = TabFor(i)) {
+      linked.insert(tab);
+    }
+  }
+  if (!parent()) {
+    return;
+  }
+  // Walk the tab strip (our parent) for tab views.
+  std::vector<views::View*> pending(parent()->children().begin(),
+                                    parent()->children().end());
+  while (!pending.empty()) {
+    views::View* view = pending.back();
+    pending.pop_back();
+    if (auto* tab_view = views::AsViewClass<TabView>(view)) {
+      const tabs::TabInterface* tab = tab_view->GetTabInterface();
+      const bool in_link = tab && !tab->IsPinned() && linked.contains(tab);
+      if (tab_view->GetProperty(kBibaTabInLinkKey) != in_link) {
+        tab_view->SetProperty(kBibaTabInLinkKey, in_link);
+        if (tab_view->parent()) {
+          tab_view->parent()->InvalidateLayout();
+        }
+      }
+      continue;
+    }
+    if (view == this) {
+      continue;
+    }
+    for (views::View* child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+}
+
+void BibaPinnedLinksView::AddedToWidget() {
+  HideLinkedTabsFromList();
 }
 
