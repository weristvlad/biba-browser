 void BibaSpacesController::SelfTestStep(int step) {
+  // DEBUG: --biba-pin-tabs=N pins the first N tabs before the run.
+  if (step == 0) {
+    int pin = 0;
+    if (base::StringToInt(base::CommandLine::ForCurrentProcess()
+                              ->GetSwitchValueASCII("biba-pin-tabs"),
+                          &pin)) {
+      for (int i = 0; i < pin && i < tab_strip_model_->count(); ++i) {
+        tab_strip_model_->SetTabPinned(i, true);
+      }
+    }
+  }
   if (step == 0) {
     BibaPokeFirstTab(debug_browser_, /*click_copy=*/false);
   }
