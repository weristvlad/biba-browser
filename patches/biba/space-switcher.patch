+// Copyright 2026 The Biba Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/biba_space_swipe_handler.h"
+
+#include <cmath>
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_command_controller.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/gfx/animation/animation.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/geometry/transform.h"
+#include "ui/views/animation/animation_builder.h"
+#include "ui/views/view.h"
+
+namespace {
+
+constexpr int kMaxSpaces = 9;
+// Horizontal travel that commits a swipe.
+constexpr float kSwipeThreshold = 90.0f;
+// Horizontal must clearly dominate vertical, so tab-list scrolling never
+// switches Spaces by accident.
+constexpr float kHorizontalDominance = 1.5f;
+// Slide-in: starts this fraction of the sidebar width off to the side.
+constexpr float kSlideFraction = 0.35f;
+// Close to Dia's "firm" spring (response 0.25 s, damping 0.9).
+constexpr base::TimeDelta kSlideDuration = base::Milliseconds(280);
+
+}  // namespace
+
+BibaSpaceSwipeHandler::BibaSpaceSwipeHandler(BrowserWindowInterface* browser,
+                                             views::View* sidebar_content)
+    : browser_(browser), sidebar_content_(sidebar_content) {
+  if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+    space_changed_subscription_ = commands->BibaAddSpaceChangedCallback(
+        base::BindRepeating(&BibaSpaceSwipeHandler::OnSpaceChanged,
+                            base::Unretained(this)));
+  }
+}
+
+BibaSpaceSwipeHandler::~BibaSpaceSwipeHandler() = default;
+
+int BibaSpaceSwipeHandler::NeighbourSpace(int direction) const {
+  const auto* commands = chrome::BrowserCommandController::From(browser_);
+  if (!commands) {
+    return -1;
+  }
+  for (int i = commands->biba_active_space() + direction;
+       i >= 0 && i < kMaxSpaces; i += direction) {
+    if (commands->biba_space_in_use(i)) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+void BibaSpaceSwipeHandler::OnScrollEvent(ui::ScrollEvent* event) {
+  if (event->type() != ui::EventType::kScroll) {
+    return;
+  }
+  if (event->scroll_event_phase() == ui::ScrollEventPhase::kBegan) {
+    accumulated_x_ = 0.0f;
+    switched_this_gesture_ = false;
+  }
+  // Ignore inertia; only the fingers' own travel counts.
+  if (event->momentum_phase() != ui::EventMomentumPhase::NONE) {
+    return;
+  }
+  const float dx = event->x_offset();
+  const float dy = event->y_offset();
+  if (std::fabs(dx) <= std::fabs(dy) * kHorizontalDominance) {
+    return;
+  }
+  // A horizontal gesture over the sidebar is ours; don't let it scroll
+  // anything else.
+  event->SetHandled();
+  if (switched_this_gesture_) {
+    return;
+  }
+  accumulated_x_ += dx;
+  if (std::fabs(accumulated_x_) < kSwipeThreshold) {
+    return;
+  }
+  // Content follows the fingers: swiping left (negative x offset) reveals the
+  // next Space on the right.
+  const int target = NeighbourSpace(accumulated_x_ < 0 ? +1 : -1);
+  switched_this_gesture_ = true;
+  if (target < 0) {
+    return;
+  }
+  if (auto* commands = chrome::BrowserCommandController::From(browser_)) {
+    commands->ExecuteCommand(IDC_BIBA_SWITCH_SPACE_0 + target);
+  }
+}
+
+void BibaSpaceSwipeHandler::OnSpaceChanged(int from, int to) {
+  ui::Layer* layer = sidebar_content_ ? sidebar_content_->layer() : nullptr;
+  if (!layer || from == to) {
+    return;
+  }
+  if (gfx::Animation::PrefersReducedMotion()) {
+    // Reduced motion: a plain cross-fade, no movement.
+    layer->SetOpacity(0.0f);
+    views::AnimationBuilder()
+        .Once()
+        .SetDuration(base::Milliseconds(150))
+        .SetOpacity(layer, 1.0f, gfx::Tween::EASE_OUT);
+    return;
+  }
+  // The new Space enters from the side it lives on.
+  const float direction = to > from ? 1.0f : -1.0f;
+  gfx::Transform start;
+  start.Translate(direction * kSlideFraction * sidebar_content_->width(), 0);
+  layer->SetTransform(start);
+  layer->SetOpacity(0.0f);
+  views::AnimationBuilder()
+      .SetPreemptionStrategy(
+          ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET)
+      .Once()
+      .SetDuration(kSlideDuration)
+      .SetTransform(layer, gfx::Transform(), gfx::Tween::ACCEL_20_DECEL_100)
+      .SetOpacity(layer, 1.0f, gfx::Tween::EASE_OUT);
+}
