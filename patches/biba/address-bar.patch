+void LocationBarView::RefreshBibaTitle() {
+  if (!biba_title_label_ || !omnibox_view_) {
+    return;
+  }
+  auto* edit_model = GetOmniboxController()->edit_model();
+  const bool at_rest = !edit_model->user_input_in_progress() &&
+                       !edit_model->is_caret_visible() &&
+                       !omnibox_view_->HasFocus();
+  const bool minimal =
+      GetProfile() &&
+      GetProfile()->GetPrefs()->GetBoolean(prefs::kHeliumMinimalLocationBar);
+  WebContents* contents = GetWebContents();
+  std::u16string title = contents ? contents->GetTitle() : std::u16string();
+  const GURL url = contents ? contents->GetVisibleURL() : GURL();
+  // The title adds nothing when it just repeats the address.
+  const bool useful = !title.empty() && url.is_valid() &&
+                      !url.SchemeIs(content::kChromeUIScheme) &&
+                      title != base::UTF8ToUTF16(url.host()) &&
+                      title != base::UTF8ToUTF16(url.spec());
+  const bool show = at_rest && minimal && useful && !is_popup_mode_;
+  biba_title_label_->SetVisible(show);
+  if (show) {
+    biba_title_label_->SetText(u" / " + title);
+    biba_title_label_->SetFontList(omnibox_view_->GetFontList());
+    if (const auto* color_provider = GetColorProvider()) {
+      biba_title_label_->SetEnabledColor(
+          color_provider->GetColor(kColorOmniboxTextDimmed));
+    }
+    LayoutBibaTitle();
+  }
+}
+
+void LocationBarView::LayoutBibaTitle() {
+  if (!biba_title_label_ || !biba_title_label_->GetVisible()) {
+    return;
+  }
+  // Right after the URL text, within the omnibox's slot.
+  const gfx::Rect omnibox = omnibox_view_->bounds();
+  const int text_end = omnibox.x() + omnibox_view_->GetInsets().left() +
+                       omnibox_view_->GetUnelidedTextWidth();
+  const int width = std::max(0, omnibox.right() - text_end);
+  biba_title_label_->SetBounds(text_end, omnibox.y(), width, omnibox.height());
+}
